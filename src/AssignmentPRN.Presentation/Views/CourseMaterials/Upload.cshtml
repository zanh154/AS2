@model CourseMaterialUploadViewModel
@{
    ViewData["Title"] = "Tải lên tài liệu";
}
<div class="page-header">
    <div>
        <a class="back-link" asp-action="Index">← Tài liệu môn</a>
        <h1>@ViewData["Title"]</h1>
        <p>Chấp nhận PDF, Word, PowerPoint; tối đa 20 MB mỗi tệp.</p>
    </div>
</div>

<form asp-action="Upload" method="post" enctype="multipart/form-data" class="content-card">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="CourseId" class="form-label"></label>
            <partial name="_SearchableSelect" model="@(new SearchableSelectViewModel
            {
                Name = nameof(CourseMaterialUploadViewModel.CourseId),
                SelectedValue = Model.CourseId,
                Placeholder = "Chọn môn học",
                SearchPlaceholder = "Tìm mã hoặc tên môn học",
                EmptyText = "Không tìm thấy môn học phù hợp",
                Options = Model.CourseOptions
            })" />
            <span asp-validation-for="CourseId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="File" class="form-label"></label>
            <input asp-for="File" class="form-control" accept="@MaterialFileRules.AcceptAttribute" />
            <span asp-validation-for="File" class="text-danger"></span>
        </div>
    </div>

    <div class="info-note">
        Tài liệu tải lên được dùng làm chủ đề ngay, không cần chờ xử lý và được lưu an toàn trên máy chủ.
    </div>

    <div class="form-actions">
        <button class="btn btn-primary">Tải lên</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Huỷ</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
