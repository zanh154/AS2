@model IReadOnlyList<AcademicClassResponse>
@{
    ViewData["Title"] = "Lớp học";
    ViewData["Breadcrumb"] = new List<BreadcrumbItem> { new("Lớp học") };

    var table = new DataTableViewModel
    {
        Columns =
        [
            new("Lớp"),
            new("Môn học"),
            new("Giảng viên"),
            new("Sĩ số"),
            new("Trạng thái"),
            new("Thao tác", AlignEnd: true)
        ],
        Rows = Model.Select(item => new List<TableCell>
        {
            new StackCell(item.ClassName, item.ClassCode),
            new StackCell(item.CourseCode, item.CourseName),
            new TextCell(item.LecturerName, Nowrap: true),
            new CountCell(item.StudentCount, "sinh viên"),
            new ChipCell(item.IsActive ? "Đang hoạt động" : "Ngừng hoạt động",
                item.IsActive ? "status-chip--success" : "status-chip--muted"),
            new ActionsCell(
            [
                new("Sinh viên", "users", "Roster", new { id = item.ClassId }, Tone: "primary"),
                new("Sửa lớp", "pencil", "Edit", new { id = item.ClassId }),
                new("Xoá lớp", "trash", "Delete", new { id = item.ClassId }, Tone: "danger", IsPost: true,
                    Confirm: $"Xoá lớp {item.ClassCode}? Lớp còn sinh viên sẽ không được xoá.")
            ])
        } as IReadOnlyList<TableCell>).ToList()
    };
}
<div class="page-header">
    <div><span class="eyebrow">Quản lý đào tạo</span><h1>Lớp học</h1><p>Lớp là danh sách sinh viên mà phiên thi lấy thí sinh từ đó.</p></div>
    <a class="btn btn-primary" asp-action="Create"><partial name="_Icon" model="@("plus")" /> Thêm lớp học</a>
</div>

@if (Model.Count > 0)
{
    <section class="metric-row" aria-label="Tổng quan lớp học">
        <div class="metric-card"><span>Lớp học</span><strong>@Model.Count</strong></div>
        <div class="metric-card"><span>Đang hoạt động</span><strong>@Model.Count(x => x.IsActive)</strong></div>
        <div class="metric-card"><span>Tổng sinh viên</span><strong>@Model.Sum(x => x.StudentCount)</strong></div>
    </section>
}

<div class="content-card">
@if (Model.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon"><partial name="_Icon" model="@("users")" /></div>
        <h2>Chưa có lớp học</h2>
        <p>Tạo lớp và thêm sinh viên trước khi tạo lịch thi.</p>
        <a class="btn btn-primary" asp-action="Create">Thêm lớp học</a>
    </div>
}
else
{
    <partial name="_DataTable" model="table" />
}
</div>
