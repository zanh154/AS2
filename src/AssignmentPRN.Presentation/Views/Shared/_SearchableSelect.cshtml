@model SearchableSelectViewModel
@{
    var selectedValue = Model.SelectedKey
        ?? (Model.SelectedValue > 0 ? Model.SelectedValue.ToString() : string.Empty);
    var selectedOption = Model.Options.FirstOrDefault(option => option.Value == selectedValue);
    var selectedSeparator = selectedOption?.Text.IndexOf(" · ", StringComparison.Ordinal) ?? -1;
    var selectedLabel = selectedSeparator >= 0
        ? selectedOption!.Text[..selectedSeparator]
        : selectedOption?.Text;
    var extraAttrs = string.Join(" ", Model.Attributes.Select(a =>
        string.IsNullOrEmpty(a.Value) ? a.Key : $"{a.Key}=\"{a.Value}\""));
}

<div class="select-picker @(Model.ShowAvatar ? null : "select-picker--plain")" data-select-picker>
    <button class="select-picker__trigger" type="button"
            aria-haspopup="listbox" aria-expanded="false"
            data-select-trigger>
        <span class="select-picker__value @(selectedLabel is null ? "is-placeholder" : null)"
              data-select-label>
            @(selectedLabel ?? Model.Placeholder)
        </span>
        <span class="select-picker__chevron" aria-hidden="true"></span>
    </button>

    <select id="@Model.Name" name="@Model.Name" class="visually-hidden"
            tabindex="-1" aria-hidden="true" data-select-value @Html.Raw(extraAttrs)>
        <option value="">@Model.Placeholder</option>
        @foreach (var option in Model.Options)
        {
            var isSelected = option.Value == selectedValue;
            <option value="@option.Value" selected="@isSelected">@option.Text</option>
        }
    </select>

    <div class="select-picker__panel" role="listbox" aria-hidden="true" data-select-panel>
        <div class="select-picker__search-wrap">
            <partial name="_Icon" model="@("search")" />
            <input class="select-picker__search" type="search"
                   placeholder="@Model.SearchPlaceholder" autocomplete="off"
                   aria-label="@Model.SearchPlaceholder" data-select-search />
        </div>
        <div class="select-picker__options" data-select-options>
            @foreach (var option in Model.Options)
            {
                var separator = option.Text.IndexOf(" · ", StringComparison.Ordinal);
                var primary = separator >= 0 ? option.Text[..separator] : option.Text;
                var secondary = separator >= 0 ? option.Text[(separator + 3)..] : string.Empty;
                var isSelected = option.Value == selectedValue;

                <button class="select-picker__option @(isSelected ? "is-selected" : null)"
                        type="button" role="option" aria-selected="@(isSelected ? "true" : "false")"
                        data-select-option data-value="@option.Value"
                        data-group="@option.Group?.Name"
                        data-label="@primary" data-search-text="@option.Text">
                    @if (Model.ShowAvatar)
                    {
                        <span class="select-picker__avatar" aria-hidden="true">
                            @(string.IsNullOrWhiteSpace(primary) ? "?" : primary[..1].ToUpperInvariant())
                        </span>
                    }
                    <span class="select-picker__identity">
                        <strong>@primary</strong>
                        @if (!string.IsNullOrWhiteSpace(secondary))
                        {
                            <span>@secondary</span>
                        }
                    </span>
                    <span class="select-picker__check" aria-hidden="true">✓</span>
                </button>
            }
            <div class="select-picker__empty" hidden data-select-empty>@Model.EmptyText</div>
        </div>
    </div>
</div>
