@* Trail set by each view through ViewData["Breadcrumb"]. The last hop is the current page.
   A single hop would only repeat the page title, so the trail starts at two. *@
@model IReadOnlyList<BreadcrumbItem>
@if (Model.Count > 1)
{
    <nav class="breadcrumb-trail" aria-label="Đường dẫn">
        <ol>
            @for (var i = 0; i < Model.Count; i++)
            {
                var item = Model[i];
                var isLast = i == Model.Count - 1;
                <li>
                    @if (isLast || item.Controller is null)
                    {
                        <span aria-current="@(isLast ? "page" : null)">@item.Text</span>
                    }
                    else if (item.Controller is "Courses" or "ExamSessions" or "ExamResults")
                    {
                        @* Hai nhánh riêng, không dùng ternary: tag helper coi asp-page và
                           asp-controller/asp-action là loại trừ nhau ngay cả khi giá trị là null,
                           và ném lỗi 500 khi gặp cả hai. *@
                        <a asp-page="/@item.Controller/@item.Action" asp-all-route-data="@RouteDataFor(item)">@item.Text</a>
                    }
                    else
                    {
                        <a asp-controller="@item.Controller" asp-action="@item.Action"
                           asp-all-route-data="@RouteDataFor(item)">@item.Text</a>
                    }
                    @if (!isLast)
                    {
                        <span class="breadcrumb-trail__sep" aria-hidden="true">
                            <partial name="_Icon" model="@("chevron-right")" />
                        </span>
                    }
                </li>
            }
        </ol>
    </nav>
}
@functions {
    private static Dictionary<string, string> RouteDataFor(BreadcrumbItem item) =>
        item.RouteValues is null
            ? new Dictionary<string, string>()
            : new Microsoft.AspNetCore.Routing.RouteValueDictionary(item.RouteValues)
                .ToDictionary(pair => pair.Key, pair => pair.Value?.ToString() ?? string.Empty);
}
