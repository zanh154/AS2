@{
    var fullName = Context.Session.GetString(SessionKeys.FullName) ?? string.Empty;
    var role = Context.Session.GetString(SessionKeys.Role);
    var isSignedIn = Context.Session.GetInt32(SessionKeys.UserId).HasValue;
    var initial = string.IsNullOrEmpty(fullName) ? "?" : fullName[..1].ToUpperInvariant();

    var roleLabel = role switch
    {
        RoleNames.Admin => "Quản trị viên",
        RoleNames.Lecturer => "Giảng viên",
        RoleNames.Student => "Sinh viên",
        _ => role ?? string.Empty
    };

    var homeAction = role switch
    {
        RoleNames.Admin => ("Index", "Admin"),
        RoleNames.Lecturer => ("Index", "Lecturer"),
        _ => ("Index", "Student")
    };
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · AIVES</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-md">
            <div class="app-shell d-flex flex-wrap align-items-center">
                <a class="navbar-brand" asp-controller="@homeAction.Item2" asp-action="@homeAction.Item1">
                    <span class="brand-mark" aria-hidden="true">AV</span>
                    <span>AIVES</span>
                </a>

                @if (isSignedIn)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                            data-bs-target="#mainNavigation" aria-controls="mainNavigation"
                            aria-expanded="false" aria-label="Mở menu">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="mainNavigation">
                        <ul class="navbar-nav ms-auto align-items-md-center gap-md-1">
                            @if (role is RoleNames.Admin or RoleNames.Lecturer)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="ExamSessions" asp-action="Index">Lịch thi</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="StudentSchedule" asp-action="Index">Tra cứu sinh viên</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Classes" asp-action="Index">Lớp học</a>
                                </li>
                            }
                            else if (role == RoleNames.Student)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="StudentSchedule" asp-action="Mine">Lịch thi của tôi</a>
                                </li>
                            }
                        </ul>

                        <div class="nav-user">
                            <span class="nav-user__avatar" aria-hidden="true">@initial</span>
                            <span class="nav-user__meta">
                                <span class="nav-user__name">@fullName</span>
                                <span class="nav-user__role">@roleLabel</span>
                            </span>
                            <form method="post" asp-page="/Account/Logout">
                                <button class="nav-logout" type="submit">
                                    <partial name="_Icon" model="@("logout")" />
                                    <span class="d-none d-lg-inline">Đăng xuất</span>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </nav>
    </header>

    <main class="app-shell page-content">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success app-alert" role="status">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger app-alert" role="alert">@error</div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="app-shell">AIVES · AI-powered Viva Exam System</div>
    </footer>

    <div class="confirm-backdrop" id="confirm-backdrop" aria-hidden="true">
        <div class="confirm-dialog" role="alertdialog" aria-modal="true"
             aria-labelledby="confirm-title" aria-describedby="confirm-message">
            <p class="confirm-dialog__message" id="confirm-message"></p>
            <div class="confirm-dialog__actions">
                <button class="btn btn-outline-secondary confirm-dialog__cancel" id="confirm-cancel">Huỷ</button>
                <button class="btn btn-danger confirm-dialog__ok" id="confirm-ok">Xác nhận</button>
            </div>
        </div>
    </div>

    <div class="realtime-notice" id="realtime-notice" role="status" aria-live="polite" hidden>
        <span id="realtime-notice-message">Danh sách vừa thay đổi.</span>
        <button type="button" id="realtime-notice-refresh">Cập nhật</button>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @if (isSignedIn)
    {
        <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
