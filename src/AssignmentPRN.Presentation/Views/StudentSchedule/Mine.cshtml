@model StudentScheduleViewModel
@{
    ViewData["Title"] = "Lịch thi của tôi";
    ViewData["Breadcrumb"] = new List<BreadcrumbItem> { new("Lịch thi của tôi") };
}

<div class="page-header">
    <div>
        <a class="back-link" asp-controller="Student" asp-action="Index"><partial name="_Icon" model="@("arrow-left")" /> Quay lại bảng điều khiển</a>
        <span class="eyebrow">Dành cho sinh viên</span>
        <h1>Lịch thi của tôi</h1>
        <p>Ngày, giờ và môn thi vấn đáp đã được xếp cho bạn.</p>
    </div>
</div>

<div class="lookup-layout">
    <partial name="_ScheduleList" model="Model" />
</div>
