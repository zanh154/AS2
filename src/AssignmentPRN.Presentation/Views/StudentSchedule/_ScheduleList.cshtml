@model StudentScheduleViewModel
@{
    var currentRole = Context.Session.GetString(SessionKeys.Role);
    var currentUserId = Context.Session.GetInt32(SessionKeys.UserId);
}

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger" role="alert">@Model.Error</div>
}
else if (Model.Schedule is not null)
{
    var schedule = Model.Schedule;
    var initial = string.IsNullOrEmpty(schedule.StudentName) ? "?" : schedule.StudentName[..1].ToUpperInvariant();

    <section class="student-result-header">
        <div class="avatar avatar--lg" aria-hidden="true">@initial</div>
        <div>
            <span>Lịch thi của</span>
            <h2>@schedule.StudentName</h2>
            <strong>@schedule.StudentEmail</strong>
        </div>
    </section>

    if (schedule.Items.Count == 0)
    {
        <div class="content-card empty-state">
            <div class="empty-icon"><partial name="_Icon" model="@("calendar")" /></div>
            <h3>Chưa có lịch thi</h3>
            <p>@(Model.IsOwnSchedule ? "Bạn chưa được xếp vào ca thi nào." : "Sinh viên này chưa được xếp vào ca thi nào.")</p>
        </div>
    }
    else
    {
        <div class="student-schedule-list">
            @foreach (var item in schedule.Items)
            {
                var canOpenSession = currentRole == RoleNames.Admin
                    || (currentRole == RoleNames.Lecturer && currentUserId == item.LecturerId);
                if (canOpenSession)
                {
                    <a class="student-schedule-item" asp-controller="ExamSessions" asp-action="Details"
                       asp-route-id="@item.ExamId">
                        <partial name="_ScheduleItem" model="item" />
                    </a>
                }
                else
                {
                    <div class="student-schedule-item">
                        <partial name="_ScheduleItem" model="item" />
                    </div>
                }
            }
        </div>
    }
}
