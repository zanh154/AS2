@model StudentScheduleViewModel
@{
    // Only staff may follow a slot through to the full session detail page.
    var now = DateTime.Now;
    var currentRole = Context.Session.GetString(SessionKeys.Role);
    var currentUserId = Context.Session.GetInt32(SessionKeys.UserId);
}

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger" role="alert">@Model.Error</div>
}
else if (Model.Schedule is not null)
{
    var schedule = Model.Schedule;
    var initial = string.IsNullOrEmpty(schedule.StudentName) ? "?" : schedule.StudentName[..1].ToUpperInvariant();

    <section class="student-result-header">
        <div class="avatar avatar--lg" aria-hidden="true">@initial</div>
        <div>
            <span>Lịch thi của</span>
            <h2>@schedule.StudentName</h2>
            <strong>@schedule.StudentEmail</strong>
        </div>
    </section>

    if (schedule.Items.Count == 0)
    {
        <div class="content-card empty-state">
            <div class="empty-icon"><partial name="_Icon" model="@("calendar")" /></div>
            <h3>Chưa có lịch thi</h3>
            <p>@(Model.IsOwnSchedule ? "Bạn chưa được xếp vào ca thi nào." : "Sinh viên này chưa được xếp vào ca thi nào.")</p>
        </div>
    }
    else
    {
        <div class="student-schedule-list">
            @foreach (var item in schedule.Items)
            {
                var canOpenSession = currentRole == RoleNames.Admin
                    || (currentRole == RoleNames.Lecturer && currentUserId == item.LecturerId);
                if (canOpenSession)
                {
                    <a class="student-schedule-item"  asp-page="/ExamSessions/Details"
                       asp-route-id="@item.ExamId">
                        <partial name="_ScheduleItem" model="item" />
                    </a>
                }
                else
                {
                    // The same window the service enforces, so the button is only offered
                    // when pressing it would actually work.
                    var canSit = Model.IsOwnSchedule
                        && ExamSessionRules.CanSit(item.SessionStatus)
                        && item.CandidateStatus is CandidateStatus.Waiting or CandidateStatus.InProgress
                        && ExamSessionRules.IsSlotOpen(now, item.ScheduledTime, item.EndTime);

                    <div class="student-schedule-item">
                        <partial name="_ScheduleItem" model="item" />
                        @if (Model.IsOwnSchedule && !canSit && item.CandidateStatus != CandidateStatus.Completed)
                        {
                            var reason = item.CandidateStatus is CandidateStatus.Cancelled or CandidateStatus.Absent
                                ? "Lượt thi đã hủy hoặc được ghi nhận vắng thi."
                                : now > item.EndTime ? "Ca thi đã kết thúc."
                                : !ExamSessionRules.CanSit(item.SessionStatus) ? "Phiên thi chưa mở hoặc đã kết thúc."
                                : $"Mở lúc {item.ScheduledTime:dd/MM/yyyy HH:mm}.";
                            <div class="student-schedule-item__action">
                                <button class="btn btn-outline-secondary" type="button" disabled
                                        aria-describedby="voice-entry-reason-@item.CandidateId">Thi giọng nói</button>
                                <small id="voice-entry-reason-@item.CandidateId">@reason</small>
                            </div>
                        }
                        @if (Model.IsOwnSchedule && item.CandidateStatus == CandidateStatus.Completed)
                        {
                            <a class="btn btn-outline-secondary" asp-controller="ExamRoom" asp-action="Result" asp-route-id="@item.CandidateId">Xem bài đã nộp</a>
                            <a class="btn btn-outline-primary" asp-page="/MyResults/Index" asp-route-id="@item.CandidateId">Xem điểm và nhận xét</a>
                        }
                        @if (canSit)
                        {
                            <form method="post" asp-page="/VoiceRoom/Index" asp-page-handler="Enter"
                                  asp-route-id="@item.CandidateId" class="student-schedule-item__action">
                                <button class="btn btn-outline-primary" type="submit">Thi giọng nói</button>
                            </form>
                            <form method="post" asp-controller="ExamRoom" asp-action="Enter"
                                  asp-route-id="@item.CandidateId" class="student-schedule-item__action">
                                <button class="btn btn-primary" type="submit">
                                    @(item.CandidateStatus == CandidateStatus.InProgress ? "Tiếp tục thi" : "Vào thi")
                                </button>
                            </form>
                        }
                    </div>
                }
            }
        </div>
    }
}
