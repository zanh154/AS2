@model DocumentQuestionReviewViewModel
@{
    ViewData["Title"] = Model.IsNew ? "Duyệt câu hỏi mới" : "Xem/Xét duyệt câu hỏi";
}
<div class="page-header">
    <div>
        <a class="back-link" asp-action="Questions" asp-route-documentId="@Model.DocumentId">← Danh sách câu hỏi</a>
        <h1>@(Model.IsNew ? "Duyệt câu hỏi mới" : "Xem/Xét duyệt câu hỏi")</h1>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success app-alert" role="alert">@success</div>
}
@{
    var danger = TempData["Error"] as string ?? Model.LoadError;
}
@if (danger is not null)
{
    <div class="alert alert-danger app-alert" role="alert">@danger</div>
}

@if (Model.Question is not null)
{
<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5>Nội dung câu hỏi</h5>
            </div>
            <div class="card-body">
                <form asp-action="Review" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="questionId" value="@Model.Question.QuestionId" />
                    <input type="hidden" name="documentId" value="@Model.DocumentId" />

                    <div class="mb-3">
                        <label class="form-label">Câu hỏi <span class="text-danger">*</span></label>
                        <textarea name="questionText" class="form-control" rows="4" required>@Model.Question.QuestionText</textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Đáp án đúng</label>
                        <textarea name="answerKey" class="form-control" rows="3">@Model.Question.AnswerKey</textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Giải thích</label>
                        <textarea name="explanation" class="form-control" rows="3">@Model.Question.Explanation</textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Mức độ Bloom</label>
                            <select name="bloomLevel" class="form-select">
                                <option value="1" selected="@(Model.Question.BloomLevel == DocumentBloomLevel.Remember)">Remember (Nhớ)</option>
                                <option value="2" selected="@(Model.Question.BloomLevel == DocumentBloomLevel.Understand)">Understand (Hiểu)</option>
                                <option value="3" selected="@(Model.Question.BloomLevel == DocumentBloomLevel.Apply)">Apply (Áp dụng)</option>
                                <option value="4" selected="@(Model.Question.BloomLevel == DocumentBloomLevel.Analyze)">Analyze (Phân tích)</option>
                                <option value="5" selected="@(Model.Question.BloomLevel == DocumentBloomLevel.Evaluate)">Evaluate (Đánh giá)</option>
                                <option value="6" selected="@(Model.Question.BloomLevel == DocumentBloomLevel.Create)">Create (Sáng tạo)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Chủ đề</label>
                            <input type="text" name="topic" class="form-control" value="@Model.Question.Topic" placeholder="Ví dụ: Lập trình hướng đối tượng" />
                        </div>
                    </div>

                    @if (Model.Question.Status == GeneratedQuestionStatus.PendingReview)
                    {
                        <div class="mb-3">
                            <label class="form-label">Quyết định <span class="text-danger">*</span></label>
                            <div class="btn-group w-100" role="group">
                                <input type="radio" class="btn-check" name="decision" id="approve" value="1" checked />
                                <label class="btn btn-success" for="approve">Duyệt</label>
                                <input type="radio" class="btn-check" name="decision" id="reject" value="2" />
                                <label class="btn btn-danger" for="reject">Từ chối</label>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">Trạng thái hiện tại</label>
                            <div class="form-control-plaintext">
                                <span class="badge @DocumentText.QuestionStatusBadge(Model.Question.Status)">
                                    @DocumentText.QuestionStatus(Model.Question.Status)
                                </span>
                                <span class="ms-2 text-muted">
                                    Đã duyệt bởi @Model.Question.ReviewedByName vào @Model.Question.ReviewedAt?.ToString("dd/MM/yyyy HH:mm")
                                </span>
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Ghi chú duyệt (tùy chọn)</label>
                        <textarea name="notes" class="form-control" rows="2" placeholder="Lý do duyệt/từ chối..."></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Lưu quyết định</button>
                        <a asp-action="Questions" asp-route-documentId="@Model.DocumentId" class="btn btn-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5>Thông tin</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">ID</dt>
                    <dd class="col-sm-8">@Model.Question.QuestionId</dd>

                    <dt class="col-sm-4">Tài liệu gốc</dt>
                    <dd class="col-sm-8">@Model.Question.DocumentId</dd>

                    <dt class="col-sm-4">Ngày tạo</dt>
                    <dd class="col-sm-8">@Model.Question.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-4">Trạng thái</dt>
                    <dd class="col-sm-8">
                        <span class="badge @DocumentText.QuestionStatusBadge(Model.Question.Status)">
                            @DocumentText.QuestionStatus(Model.Question.Status)
                        </span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</div>
}
