@model DocumentQuestionsViewModel
@{
    ViewData["Title"] = "Câu hỏi theo tài liệu";
}
<div class="page-header">
    <div>
        <a class="back-link" asp-action="Details" asp-route-id="@Model.DocumentId">← Chi tiết tài liệu</a>
        <h1>@ViewData["Title"]</h1>
        <p class="text-muted">Lọc và duyệt các câu hỏi AI đã sinh từ tài liệu này.</p>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success app-alert" role="alert">@success</div>
}
@{
    var danger = TempData["Error"] as string ?? Model.LoadError;
}
@if (danger is not null)
{
    <div class="alert alert-danger app-alert" role="alert">@danger</div>
}

<div class="card mb-4">
    <div class="card-header">
        <h5>Bộ lọc</h5>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Questions" class="row g-3">
            <input type="hidden" name="documentId" value="@Model.DocumentId" />
            <div class="col-md-3">
                <label class="form-label">Trạng thái</label>
                <select name="status" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="0" selected="@(Model.StatusFilter == 0)">Chờ duyệt</option>
                    <option value="1" selected="@(Model.StatusFilter == 1)">Đã duyệt</option>
                    <option value="2" selected="@(Model.StatusFilter == 2)">Đã từ chối</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Mức độ Bloom</label>
                <select name="bloomLevel" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="1" selected="@(Model.BloomFilter == 1)">Remember</option>
                    <option value="2" selected="@(Model.BloomFilter == 2)">Understand</option>
                    <option value="3" selected="@(Model.BloomFilter == 3)">Apply</option>
                    <option value="4" selected="@(Model.BloomFilter == 4)">Analyze</option>
                    <option value="5" selected="@(Model.BloomFilter == 5)">Evaluate</option>
                    <option value="6" selected="@(Model.BloomFilter == 6)">Create</option>
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary me-2">Lọc</button>
                <a asp-action="Questions" asp-route-documentId="@Model.DocumentId" class="btn btn-outline-secondary">Xoá lọc</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Danh sách câu hỏi (@Model.Questions.Count)</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Questions.Count == 0)
        {
            <div class="p-4 text-center text-muted">Không có câu hỏi nào.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th style="width: 40%">Nội dung câu hỏi</th>
                            <th style="width: 15%">Mức độ Bloom</th>
                            <th style="width: 15%">Chủ đề</th>
                            <th style="width: 15%">Trạng thái</th>
                            <th style="width: 15%">Người duyệt</th>
                            <th style="width: 15%">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var q in Model.Questions)
                        {
                            <tr>
                                <td>
                                    <div>@q.QuestionText</div>
                                    @if (!string.IsNullOrEmpty(q.Explanation))
                                    {
                                        <small class="text-muted">Giải thích: @q.Explanation[..Math.Min(80, q.Explanation.Length)]...</small>
                                    }
                                </td>
                                <td><span class="badge bg-info">@DocumentText.Bloom(q.BloomLevel)</span></td>
                                <td>@(q.Topic ?? "-")</td>
                                <td>
                                    <span class="badge @DocumentText.QuestionStatusBadge(q.Status)">
                                        @DocumentText.QuestionStatus(q.Status)
                                    </span>
                                </td>
                                <td>@(q.ReviewedByName ?? "-")</td>
                                <td>
                                    <a asp-action="Review" asp-route-id="@q.QuestionId" asp-route-documentId="@Model.DocumentId" class="btn btn-sm btn-outline-primary">
                                        @(q.Status == GeneratedQuestionStatus.PendingReview ? "Duyệt" : "Xem")
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
