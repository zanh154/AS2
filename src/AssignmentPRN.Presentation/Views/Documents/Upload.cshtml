@model DocumentUploadViewModel
@{
    ViewData["Title"] = "Tải lên tài liệu";
}
<div class="page-header">
    <div>
        <a class="back-link" asp-action="Index" asp-route-courseId="@Model.CourseId">← Tài liệu &amp; AI</a>
        <h1>@ViewData["Title"]</h1>
        <p>Chấp nhận PDF, DOCX, PPTX; tối đa @Model.MaxFileSizeMB MB mỗi tệp. Tệp được xử lý nền sau khi tải lên.</p>
    </div>
</div>

<form asp-action="Upload" method="post" enctype="multipart/form-data" class="content-card">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="CourseId" class="form-label"></label>
            <partial name="_SearchableSelect" model="@(new SearchableSelectViewModel
            {
                Name = nameof(DocumentUploadViewModel.CourseId),
                SelectedValue = Model.CourseId,
                Placeholder = "Chọn môn học",
                SearchPlaceholder = "Tìm mã hoặc tên môn học",
                EmptyText = "Không tìm thấy môn học phù hợp",
                Options = Model.CourseOptions
            })" />
            <span asp-validation-for="CourseId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="File" class="form-label"></label>
            <input asp-for="File" class="form-control" accept=".pdf,.docx,.pptx" />
            <span asp-validation-for="File" class="text-danger"></span>
            <div class="form-text">Định dạng hỗ trợ: PDF, DOCX, PPTX. Kích thước tối đa: @Model.MaxFileSizeMB MB.</div>
        </div>
    </div>

    <div class="form-actions">
        <button class="btn btn-primary" id="uploadBtn">Tải lên và xử lý</button>
        <a asp-action="Index" asp-route-courseId="@Model.CourseId" class="btn btn-outline-secondary">Huỷ</a>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Khóa nút trên sự kiện submit, không phải click: submit chỉ chạy khi
        // validation đã qua và request thật sự rời trình duyệt. Khóa ở click
        // sẽ kẹt nút ở trạng thái xoay mãi nếu submit bị chặn.
        document.querySelector('form.content-card').addEventListener('submit', function () {
            const btn = document.getElementById('uploadBtn');
            const fileInput = this.querySelector('input[type="file"]');
            if (!fileInput.files.length) {
                return;
            }
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang tải lên...';
        });
    </script>
}
