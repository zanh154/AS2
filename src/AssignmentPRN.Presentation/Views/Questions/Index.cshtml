@model QuestionListViewModel
@{
    ViewData["Title"] = "Ngân hàng câu hỏi";
    var snapshotUrl = Url.Action("Snapshot", "Questions", new {
        courseId = Model.CourseId,
        materialId = Model.MaterialId,
        difficulty = Model.Difficulty,
        bloomLevel = Model.BloomLevel,
        term = Model.Term,
        includeArchived = Model.IncludeArchived
    });
}
<div data-live-page="Questions"
     data-course-id="@(Model.CourseId?.ToString() ?? string.Empty)"
     data-snapshot-url="@snapshotUrl">
    <partial name="_IndexContent" model="Model" />
</div>
