@model QuestionListViewModel
@{
    ViewData["Title"] = "Ngân hàng câu hỏi";
    var selectedDifficulty = Model.Difficulty?.ToString();
    var selectedBloom = Model.BloomLevel?.ToString();
}
<div class="page-header">
    <div>
        <span class="eyebrow">Module 5</span>
        <h1>Ngân hàng câu hỏi</h1>
        <p>Câu hỏi trắc nghiệm dùng để phát đề thi. Câu đã gán cho lịch thi sẽ được ẩn thay vì xoá.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-controller="CourseMaterials" asp-action="Index">Tài liệu môn</a>
        <a class="btn btn-outline-warning" asp-page="/Questions/Review" asp-route-courseId="@Model.CourseId">Duyệt câu AI</a>
        <a class="btn btn-outline-info" asp-page="/Rubrics/Index" asp-route-courseId="@Model.CourseId">Bộ tiêu chí</a>
        <a class="btn btn-outline-primary" asp-action="Import" asp-route-courseId="@Model.CourseId">Nhập từ CSV</a>
        <a class="btn btn-primary" asp-action="Create" asp-route-courseId="@Model.CourseId">Thêm câu hỏi</a>
    </div>
</div>

<form method="get" asp-action="Index" class="content-card question-filters">
    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label" for="courseId">Môn học</label>
            <partial name="_SearchableSelect" model="@(new SearchableSelectViewModel
            {
                Name = "courseId",
                SelectedValue = Model.CourseId ?? 0,
                Placeholder = "Tất cả môn đã phân công",
                SearchPlaceholder = "Tìm mã hoặc tên môn học",
                EmptyText = "Không tìm thấy môn học phù hợp",
                Options = Model.CourseOptions
            })" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="materialId">Chủ đề (tài liệu)</label>
            <partial name="_SearchableSelect" model="@(new SearchableSelectViewModel
            {
                Name = "materialId",
                SelectedValue = Model.MaterialId ?? 0,
                Placeholder = "Tất cả chủ đề",
                SearchPlaceholder = "Tìm tên tài liệu",
                EmptyText = "Môn đã chọn chưa có tài liệu nào",
                Options = Model.MaterialOptions
            })" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="difficulty">Độ khó</label>
            <partial name="_SearchableSelect" model="@(new SearchableSelectViewModel
            {
                Name = "difficulty",
                SelectedKey = selectedDifficulty,
                ShowAvatar = false,
                Placeholder = "Tất cả",
                SearchPlaceholder = "Tìm độ khó",
                EmptyText = "Không có mức nào phù hợp",
                Options = Model.DifficultyOptions
            })" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="bloomLevel">Mức độ Bloom</label>
            <partial name="_SearchableSelect" model="@(new SearchableSelectViewModel
            {
                Name = "bloomLevel",
                SelectedKey = selectedBloom,
                ShowAvatar = false,
                Placeholder = "Tất cả",
                SearchPlaceholder = "Tìm mức độ",
                EmptyText = "Không có mức nào phù hợp",
                Options = Model.BloomOptions
            })" />
        </div>
        <div class="col-md-6">
            <label class="form-label" for="term">Tìm trong nội dung</label>
            <input id="term" name="term" value="@Model.Term" class="form-control" placeholder="Nhập từ khoá" />
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="includeArchived" name="includeArchived" value="true" checked="@Model.IncludeArchived" />
                <label class="form-check-label" for="includeArchived">Hiện câu đã ẩn</label>
            </div>
        </div>
        <div class="col-md-3 d-flex align-items-end gap-2">
            <button class="btn btn-primary" type="submit">Lọc</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Xoá lọc</a>
        </div>
    </div>
</form>

@if (Model.LoadError is not null)
{
    <div class="alert alert-danger app-alert" role="alert">@Model.LoadError</div>
}

<div class="content-card">
    <div class="section-heading">
        <div>
            <h2>Danh sách câu hỏi</h2>
            <p class="text-muted">Có @Model.Questions.Count câu hỏi phù hợp bộ lọc.</p>
        </div>
    </div>

    @if (Model.Questions.Count == 0)
    {
        <div class="empty-state">
            <h2>Chưa có câu hỏi nào</h2>
            <p>Thêm câu hỏi trắc nghiệm hoặc nhập hàng loạt từ file CSV để bắt đầu.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Nội dung</th>
                        <th>Môn / Chủ đề</th>
                        <th>Độ khó</th>
                        <th>Bloom</th>
                        <th>Trạng thái</th>
                        <th>Người tạo</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var question in Model.Questions)
                    {
                        <tr>
                            <td>
                                <p class="question-cell">@question.QuestionText</p>
                                @if (question.QuestionType == QuestionType.FollowUp)
                                {
                                    <span class="status-chip">@QuestionText.Type(question.QuestionType)</span>
                                }
                            </td>
                            <td>
                                <strong>@question.CourseCode</strong>
                                <div class="text-muted">@(question.MaterialName ?? "Chưa gán chủ đề")</div>
                            </td>
                            <td><span class="status-chip @QuestionText.DifficultyChip(question.Difficulty)">@QuestionText.Difficulty(question.Difficulty)</span></td>
                            <td>@QuestionText.Bloom(question.BloomLevel)</td>
                            <td>
                                <span class="status-chip @(question.Status == QuestionStatus.Archived ? "status-chip--muted" : "status-chip--success")">
                                    @QuestionText.Status(question.Status)
                                </span>
                            </td>
                            <td>
                                @question.AuthorName
                                <div class="text-muted">@question.CreatedAt.ToString("dd/MM/yyyy")</div>
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@question.QuestionId">Sửa</a>
                                    @if (question.Status != QuestionStatus.Archived)
                                    {
                                        <form asp-action="Archive" asp-route-id="@question.QuestionId" method="post" data-confirm="Ẩn câu hỏi này khỏi ngân hàng? Câu đã gán cho lịch thi vẫn được giữ nguyên.">
                                            <button class="btn btn-outline-danger btn-sm">Ẩn</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
