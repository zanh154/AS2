@model ExamRoomViewModel
@{
    var room = Model.Room;
    ViewData["Title"] = $"Phòng thi · {room.ExamName}";

    // While the paper is open the exam layout hides every way off the page and runs the
    // countdown; once it is handed in the page puts the way back on itself.
    Layout = "_ExamLayout";
    ViewData["ExamLocked"] = room.CanAnswer;
    ViewData["SecondsRemaining"] = room.SecondsRemaining;
}

<div class="page-header">
    <div>
        @if (!room.CanAnswer)
        {
            <a class="back-link" asp-controller="StudentSchedule" asp-action="Mine">
                <partial name="_Icon" model="@("arrow-left")" /> Quay lại lịch thi
            </a>
        }
        <span class="eyebrow">@room.CourseCode · @room.CourseName</span>
        <h1>@room.ExamName</h1>
        <p>Giảng viên: @room.LecturerName</p>
    </div>
</div>

<section class="metric-row">
    <div class="metric-card">
        <span>Khung giờ</span>
        <strong>@room.ScheduledTime.ToString("HH:mm")–@room.EndTime.ToString("HH:mm")</strong>
    </div>
    <div class="metric-card"><span>Thời lượng</span><strong>@room.TimePerStudent phút</strong></div>
    <div class="metric-card"><span>Đã trả lời</span><strong>@room.AnsweredCount / @room.Questions.Count</strong></div>
    <div class="metric-card">
        <span>Bắt đầu lúc</span>
        <strong>@(room.StartedAt?.ToString("HH:mm") ?? "—")</strong>
    </div>
</section>

@if (room.CanAnswer && room.IsFollowUpRound)
{
    @* One inline wrapper: .info-note is a flex row and would split loose text into columns. *@
    <div class="info-note">
        <span>
            <strong>Vòng 2 · Câu hỏi đào sâu.</strong>
            Dựa trên bài làm vòng 1, hệ thống hỏi thêm những câu cùng chủ đề: câu bạn làm sai sẽ
            được hỏi lại ở mức dễ hơn, câu làm đúng được hỏi sâu hơn. Mỗi câu đào sâu tính nửa
            điểm một câu chính. <strong>Hết giờ bài sẽ tự nộp.</strong>
        </span>
    </div>
}
else if (room.CanAnswer)
{
    <div class="info-note">
        <span>
            Đề của bạn được rút ngẫu nhiên từ ngân hàng câu hỏi của môn, không trùng với sinh viên
            nào khác trong cùng phiên thi. Sau khi nộp, bạn có thể được hỏi thêm vài câu đào sâu.
            <strong>Hết giờ bài sẽ tự nộp, và vòng đã nộp thì không sửa lại được.</strong>
            Đừng rời trang khi chưa nộp.
        </span>
    </div>
}
else if (room.CandidateStatus == CandidateStatus.Completed)
{
    <div class="alert alert-success app-alert" role="status">
        Bạn đã nộp bài · @room.AnsweredCount / @room.Questions.Count câu có đáp án.
        Dưới đây là bài làm của bạn.
    </div>
}
else
{
    <div class="alert alert-warning app-alert" role="alert">
        Ca thi đã kết thúc, bạn chỉ xem lại được đề.
    </div>
}

<form method="post" asp-action="Submit" asp-route-id="@room.CandidateId"
      data-draft-url="@Url.Action("SaveDraft", new { id = room.CandidateId })"
      data-exam-form
      data-exam-guard="@(room.CanAnswer ? "true" : null)"
      data-confirm="@(room.CanAnswer ? "Nộp bài ngay? Vòng đã nộp sẽ không sửa lại được." : null)">
    @if (room.CanAnswer)
    {
        <p data-draft-status role="status" aria-live="polite">Đáp án sẽ được lưu tự động khi bạn chọn. Lưu tạm chưa phải nộp bài.</p>
    }
    <div class="content-card">
        <div class="section-heading">
            <div>
                <h2>@(room.IsFollowUpRound ? "Câu hỏi đào sâu" : "Đề thi của bạn")</h2>
                <p class="text-muted">
                    @(room.CanAnswer
                        ? "Chọn một phương án cho mỗi câu, rồi bấm Nộp bài."
                        : "Phương án bạn đã chọn được đánh dấu bên dưới.")
                </p>
            </div>
            <span class="status-chip @ExamSessionText.ChipModifier(room.CandidateStatus)">
                @ExamSessionText.Status(room.CandidateStatus)
            </span>
        </div>

        <ol class="exam-room-questions">
            @foreach (var question in room.OpenRound)
            {
                <partial name="_ExamRoomQuestion" model="@(new ExamRoomQuestionViewModel
                {
                    Question = question,
                    Editable = room.CanAnswer,
                    ParentOrderNo = Model.OrderOf(question.ParentExamQuestionId)
                })" />
            }
        </ol>

        @if (room.CanAnswer)
        {
            <div class="form-actions">
                <button class="btn btn-primary" type="submit">
                    @(room.IsFollowUpRound ? "Nộp bài" : "Nộp vòng câu hỏi chính")
                </button>
            </div>
        }
    </div>
</form>

@if (room.SubmittedRound.Count > 0)
{
    <div class="content-card">
        <div class="section-heading">
            <div>
                <h2>Vòng 1 · Câu hỏi chính</h2>
                <p class="text-muted">Đã nộp, chỉ xem lại. Đáp án đúng hiển thị sau khi bạn nộp toàn bộ bài.</p>
            </div>
            <span class="status-chip status-chip--muted">Đã nộp</span>
        </div>

        <ol class="exam-room-questions">
            @foreach (var question in room.SubmittedRound)
            {
                <partial name="_ExamRoomQuestion" model="@(new ExamRoomQuestionViewModel { Question = question })" />
            }
        </ol>
    </div>
}
