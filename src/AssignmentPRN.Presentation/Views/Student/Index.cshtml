@model StudentDashboardViewModel
@{
    ViewData["Title"] = "Bảng điều khiển sinh viên";
    var vietnamese = new System.Globalization.CultureInfo("vi-VN");
}

<partial name="_DashboardHero" model="@(DateTime.Now.ToString("dddd, dd/MM/yyyy", vietnamese))" />

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="alert alert-danger" role="alert">@Model.LoadError</div>
}

<section class="metric-row" aria-label="Tổng quan lịch thi của tôi">
    <div class="metric-card"><span>Tổng ca thi</span><strong>@Model.ExamCount</strong></div>
    <div class="metric-card"><span>Sắp tới</span><strong>@Model.UpcomingCount</strong></div>
    <div class="metric-card">
        <span>Ca gần nhất</span>
        <strong>@(Model.NextExam?.ScheduledTime.ToString("dd/MM HH:mm") ?? "—")</strong>
    </div>
</section>

@if (Model.NextExam is not null)
{
    var next = Model.NextExam;
    <div class="content-card">
        <div class="section-heading with-action mb-0">
            <div class="d-flex gap-3 align-items-start">
                <span class="icon-chip icon-chip--accent"><partial name="_Icon" model="@("clock")" /></span>
                <div>
                    <h3>@next.CourseCode · @next.CourseName</h3>
                    <p>
                        @next.ExamName ·
                        @next.ScheduledTime.ToString("HH:mm")–@next.EndTime.ToString("HH:mm")
                        ngày @next.ScheduledTime.ToString("dd/MM/yyyy") ·
                        Giảng viên @next.LecturerName
                    </p>
                </div>
            </div>
            <a class="btn btn-outline-primary" asp-controller="StudentSchedule" asp-action="Mine">Xem tất cả</a>
        </div>
    </div>
}

<div class="dashboard-grid">
    <a class="dashboard-tile" asp-controller="StudentSchedule" asp-action="Mine">
        <span class="icon-chip"><partial name="_Icon" model="@("calendar")" /></span>
        <div class="dashboard-tile__body">
            <h3>Lịch thi của tôi</h3>
            <p>Ngày, giờ và môn thi vấn đáp đã được xếp cho bạn.</p>
        </div>
        <span class="dashboard-tile__arrow"><partial name="_Icon" model="@("arrow-right")" /></span>
    </a>
</div>
