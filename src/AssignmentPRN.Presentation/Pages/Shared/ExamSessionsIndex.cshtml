@model ExamSessionListViewModel
@{
    var vietnamese = new System.Globalization.CultureInfo("vi-VN");
    var groupedSessions = Model.Sessions
        .OrderBy(session => session.StartTime)
        .GroupBy(session => session.StartTime.Date)
        .ToList();
}

<div class="page-header">
    <div>
        <span class="eyebrow">Lịch thi</span>
        <h1>Khung giờ thi vấn đáp</h1>
        <p>Theo dõi toàn bộ ca thi, thời lượng và người phụ trách trong một màn hình.</p>
    </div>
    <a class="btn btn-primary" asp-page="/ExamSessions/Create"><partial name="/Pages/Shared/_Icon.cshtml" model="@("plus")" /> Tạo lịch thi</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="alert alert-danger" role="alert">@Model.LoadError</div>
}

<section class="metric-row" aria-label="Tổng quan lịch thi">
    <div class="metric-card"><span>Ca thi</span><strong>@Model.Sessions.Count</strong></div>
    <div class="metric-card"><span>Lượt sinh viên</span><strong>@Model.Sessions.Sum(item => item.CandidateCount)</strong></div>
    <div class="metric-card"><span>Ngày có lịch</span><strong>@groupedSessions.Count</strong></div>
</section>

@if (groupedSessions.Count == 0)
{
    <div class="content-card empty-state">
        <div class="empty-icon"><partial name="/Pages/Shared/_Icon.cshtml" model="@("calendar")" /></div>
        <h2>Chưa có lịch thi</h2>
        <p>Tạo lịch đầu tiên — hệ thống sẽ tự sinh khung giờ cho từng sinh viên theo thời lượng bạn đặt.</p>
        <a class="btn btn-primary" asp-page="/ExamSessions/Create">Tạo lịch thi</a>
    </div>
}
else
{
    <div class="calendar-list">
        @foreach (var day in groupedSessions)
        {
            <section class="calendar-day">
                <div class="date-tile" aria-label="@day.Key.ToString("dd/MM/yyyy")">
                    <span>@day.Key.ToString("ddd", vietnamese)</span>
                    <strong>@day.Key.ToString("dd")</strong>
                    <small>tháng @day.Key.ToString("MM")</small>
                </div>
                <div class="day-sessions">
                    @foreach (var session in day)
                    {
                        <a class="session-row" asp-page="/ExamSessions/Details" asp-route-id="@session.ExamId">
                            <div class="session-time">
                                <strong>@session.StartTime.ToString("HH:mm")</strong>
                                <span>đến @session.EndTime.ToString("HH:mm")</span>
                            </div>
                            <div class="session-main">
                                <div class="session-title-line">
                                    <strong>@session.ExamName</strong>
                                    <span class="status-chip @ExamSessionText.ChipModifier(session.Status)">@ExamSessionText.Status(session.Status)</span>
                                </div>
                                <span>@session.CourseCode · @session.CourseName</span>
                                <small>@session.LecturerName · @session.CandidateCount sinh viên · @session.TimePerStudent phút/SV</small>
                            </div>
                            <span class="session-arrow"><partial name="/Pages/Shared/_Icon.cshtml" model="@("arrow-right")" /></span>
                        </a>
                    }
                </div>
            </section>
        }
    </div>
}
