@model AssignmentPRN.Business.Interfaces.StudentScheduleItemResponse
@{
    var vietnamese = new System.Globalization.CultureInfo("vi-VN");
}

<div class="student-schedule-date">
    <strong>@Model.ScheduledTime.ToString("dd")</strong>
    <span>tháng @Model.ScheduledTime.ToString("MM")</span>
</div>
<div class="student-schedule-time">
    <strong>@Model.ScheduledTime.ToString("HH:mm")–@Model.EndTime.ToString("HH:mm")</strong>
    <span>@Model.ScheduledTime.ToString("dddd", vietnamese)</span>
</div>
<div class="student-schedule-main">
    <strong>@Model.CourseCode · @Model.CourseName</strong>
    <span>@Model.ExamName</span>
    <small>Giảng viên: @Model.LecturerName</small>
</div>
<span class="status-chip @ExamSessionText.ChipModifier(Model.CandidateStatus)">
    @ExamSessionText.Status(Model.CandidateStatus)
</span>
