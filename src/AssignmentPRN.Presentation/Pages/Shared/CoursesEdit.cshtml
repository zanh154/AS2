@model CourseViewModel
@{
    ViewData["Title"] = Model.CourseId == 0 ? "Thêm môn học" : "Sửa môn học";
    ViewData["Breadcrumb"] = new List<BreadcrumbItem>
    {
        new("Môn học", "Courses", "Index"),
        new((string)ViewData["Title"]!)
    };
}
<div class="page-header"><div><a class="back-link" asp-page="/Courses/Index">← Môn học</a><h1>@ViewData["Title"]</h1></div></div>
<form asp-page="/Courses/Edit" method="post" class="content-card">
    <input asp-for="CourseId" type="hidden" />
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="row g-3">
        <div class="col-md-4"><label asp-for="CourseCode" class="form-label"></label><input asp-for="CourseCode" class="form-control" /></div>
        <div class="col-md-8"><label asp-for="CourseName" class="form-label"></label><input asp-for="CourseName" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="LecturerId" class="form-label"></label><partial name="/Views/Shared/_SearchableSelect.cshtml" model="@(new SearchableSelectViewModel
            {
                Name = nameof(CourseViewModel.LecturerId),
                SelectedValue = Model.LecturerId,
                Placeholder = "Chọn giảng viên",
                SearchPlaceholder = "Tìm tên hoặc email giảng viên",
                EmptyText = "Không tìm thấy giảng viên phù hợp",
                Options = Model.Lecturers
            })" /></div>
        <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
        <div class="col-12"><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
            <p class="text-muted">Môn ngừng hoạt động vẫn giữ dữ liệu cũ, nhưng không được chọn để tạo phiên thi mới.</p></div>
    </div>
    <div class="d-flex gap-2 mt-4"><button class="btn btn-primary">Lưu môn học</button><a asp-page="/Courses/Index" class="btn btn-outline-secondary">Huỷ</a></div>
</form>
