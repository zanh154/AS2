@model ExamSessionCreateViewModel
@{
    ViewData["Title"] = "Tạo lịch thi";
    ViewData["Breadcrumb"] = new List<BreadcrumbItem>
    {
        new("Lịch thi", "ExamSessions", "Index"),
        new("Tạo lịch thi")
    };
}

<div class="page-header">
    <div>
        <a class="back-link" asp-page="/ExamSessions/Index"><partial name="/Views/Shared/_Icon.cshtml" model="@("arrow-left")" /> Quay lại lịch thi</a>
        <h1>Tạo lịch thi</h1>
        <p>Chọn giờ bắt đầu và thời lượng mỗi sinh viên; các ca sẽ được xếp nối tiếp tự động.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.OptionsError))
{
    <div class="alert alert-danger" role="alert">@Model.OptionsError</div>
}

@if (Model.CanCreate)
{
    <form method="post" class="schedule-form" data-schedule-form novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <section class="content-card">
            <div class="section-heading">
                <span class="step-number">1</span>
                <div>
                    <h2>Thông tin ca thi</h2>
                    <p>Thông tin chung áp dụng cho toàn bộ sinh viên trong ca.</p>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-lg-6">
                    <label asp-for="ExamName" class="form-label"></label>
                    <input asp-for="ExamName" class="form-control" placeholder="Ví dụ: Vấn đáp PRN222 – Đợt 1" />
                    <span asp-validation-for="ExamName" class="field-validation-error"></span>
                </div>
                <div class="col-lg-3">
                    <label asp-for="CourseId" class="form-label"></label>
                    <partial name="/Views/Shared/_SearchableSelect.cshtml" model="@(new SearchableSelectViewModel
                    {
                        Name = nameof(ExamSessionCreateViewModel.CourseId),
                        SelectedValue = Model.CourseId,
                        Placeholder = "Chọn môn học",
                        SearchPlaceholder = "Tìm mã hoặc tên môn học",
                        EmptyText = "Không tìm thấy môn học phù hợp",
                        Options = Model.CourseOptions
                    })" />
                    <span asp-validation-for="CourseId" class="field-validation-error"></span>
                </div>
                <div class="col-lg-3">
                    @if (Model.IsLecturerFixed)
                    {
                    <label for="lecturer-display" class="form-label">Giảng viên</label>
                    <input id="lecturer-display" class="form-control" readonly
                           value="@Model.LecturerOptions.FirstOrDefault()?.Text" />
                    <input asp-for="LecturerId" type="hidden" />
                    <small class="text-muted">Bạn tạo phiên thi cho lớp mình phụ trách.</small>
                    }
                    else
                    {
                    <label asp-for="LecturerId" class="form-label"></label>
                    <partial name="/Views/Shared/_SearchableSelect.cshtml" model="@(new SearchableSelectViewModel
                    {
                        Name = nameof(ExamSessionCreateViewModel.LecturerId),
                        SelectedValue = Model.LecturerId,
                        Placeholder = "Chọn giảng viên",
                        SearchPlaceholder = "Tìm tên hoặc email giảng viên",
                        EmptyText = "Không tìm thấy giảng viên phù hợp",
                        Options = Model.LecturerOptions
                    })" />
                    }
                    <span asp-validation-for="LecturerId" class="field-validation-error"></span>
                </div>
                <div class="col-lg-4">
                    <label asp-for="ClassId" class="form-label"></label>
                    <div data-class-picker data-roster-url="@Url.Page("/ExamSessions/Create", "ClassRoster")">
                        <partial name="/Views/Shared/_SearchableSelect.cshtml" model="@(new SearchableSelectViewModel
                        {
                            Name = nameof(ExamSessionCreateViewModel.ClassId),
                            SelectedValue = Model.ClassId,
                            Placeholder = "Chọn lớp học",
                            SearchPlaceholder = "Tìm mã lớp hoặc môn học",
                            EmptyText = "Không tìm thấy lớp học phù hợp",
                            Options = Model.ClassOptions
                        })" />
                    </div>
                    <span asp-validation-for="ClassId" class="field-validation-error"></span>
                </div>
                <div class="col-lg-8">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="2"
                              placeholder="Ghi chú thêm cho ca thi (không bắt buộc)"></textarea>
                    <span asp-validation-for="Description" class="field-validation-error"></span>
                </div>
            </div>
        </section>

        <section class="content-card">
            <div class="section-heading">
                <span class="step-number">2</span>
                <div>
                    <h2>Thời gian và cấu hình</h2>
                    <p>Ca sau bắt đầu ngay khi ca trước kết thúc.</p>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-sm-6 col-lg-3">
                    <label asp-for="StartTime" class="form-label"></label>
                    <partial name="/Views/Shared/_DateTimePicker.cshtml" model="@(new DateTimePickerViewModel
                    {
                        Name = nameof(ExamSessionCreateViewModel.StartTime),
                        Value = Model.StartTime?.ToString("yyyy-MM-ddTHH:mm"),
                        DisplayLabel = Model.StartTime?.ToString("dd/MM/yyyy · HH:mm"),
                        Placeholder = "Chọn ngày và giờ",
                        InputAttributes = new Dictionary<string, string>
                        {
                            ["data-schedule-start"] = ""
                        }
                    })" />
                    <span asp-validation-for="StartTime" class="field-validation-error"></span>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label asp-for="TimePerStudent" class="form-label"></label>
                    <input asp-for="TimePerStudent" type="number" class="form-control" min="1" max="1440"
                           data-schedule-duration />
                    <span asp-validation-for="TimePerStudent" class="field-validation-error"></span>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label asp-for="MainQuestionCount" class="form-label"></label>
                    <input asp-for="MainQuestionCount" type="number" class="form-control" min="1" max="50" />
                    <span asp-validation-for="MainQuestionCount" class="field-validation-error"></span>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label asp-for="MaxFollowUpCount" class="form-label"></label>
                    <input asp-for="MaxFollowUpCount" type="number" class="form-control" min="0" max="50" />
                    <span asp-validation-for="MaxFollowUpCount" class="field-validation-error"></span>
                </div>
            </div>
        </section>

        <section class="content-card">
            <div class="section-heading">
                <span class="step-number">3</span>
                <div>
                    <h2>Sinh viên dự thi</h2>
                    <p>Danh sách được lấy tự động từ lớp đã chọn; mỗi sinh viên chỉ xuất hiện một lần.</p>
                </div>
            </div>

            <div class="alert alert-warning" role="alert" data-schedule-overflow hidden></div>
            <div id="participant-rows" class="participant-list" aria-live="polite"></div>
            <div id="participant-empty" class="participant-empty visible">
                Chọn lớp học để tải danh sách sinh viên.
            </div>
        </section>

        <div class="form-actions">
            <a class="btn btn-outline-secondary" asp-page="/ExamSessions/Index">Huỷ</a>
            <button class="btn btn-primary" type="submit">Tạo và sinh khung giờ</button>
        </div>
    </form>

}
