@{    var fullName = Context.Session.GetString(SessionKeys.FullName) ?? string.Empty;
    var role = Context.Session.GetString(SessionKeys.Role);
    var isSignedIn = Context.Session.GetInt32(SessionKeys.UserId).HasValue;
    var initial = string.IsNullOrEmpty(fullName) ? "?" : fullName[..1].ToUpperInvariant();

    var roleLabel = role switch
    {
        RoleNames.Admin => "Quản trị viên",
        RoleNames.Lecturer => "Giảng viên",
        RoleNames.Student => "Sinh viên",
        _ => role ?? string.Empty
    };

    var homeAction = role switch
    {
        RoleNames.Admin => "/Admin/Index",
        RoleNames.Lecturer => "/Lecturer/Index",
        _ => "/Student/Index"
    };
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · AIVES</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar">
            <div class="app-shell d-flex align-items-center">
                <a class="navbar-brand" asp-page="@homeAction">
                    <span class="brand-mark" aria-hidden="true">AV</span>
                    <span>AIVES</span>
                </a>

                @if (isSignedIn)
                {
                    <div class="d-flex align-items-center gap-2 ms-auto">
                        <button class="navbar-toggler d-md-none" type="button" data-bs-toggle="collapse"
                            data-bs-target="#sidebarNav" aria-controls="sidebarNav" aria-expanded="false" aria-label="Mở menu">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        <div class="nav-user">
                            <span class="nav-user__avatar" aria-hidden="true">@initial</span>
                            <span class="nav-user__meta d-none d-sm-flex">
                                <span class="nav-user__name">@fullName</span>
                                <span class="nav-user__role">@roleLabel</span>
                                <span class="badge bg-danger ms-2 notif-badge" role="status">
                                    <partial name="_NotificationBadge" />
                                </span>
                            </span>
                            <form method="post" asp-page="/Account/Logout">
                                <button class="nav-logout" type="submit">
                                    <partial name="_Icon" model="@("logout")" />
                                    <span class="d-none d-lg-inline">Đăng xuất</span>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </nav>
    </header>

    <div class="app-shell app-body">
        @if (isSignedIn)
        {
            <partial name="_Sidebar" />
        }

        <main class="page-content">
            @{                var trail = ViewData["Breadcrumb"] as IReadOnlyList<BreadcrumbItem> ?? [];
            }
            <partial name="_Breadcrumb" model="trail" />

            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success app-alert" role="status">@success</div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger app-alert" role="alert">@error</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="app-shell">AIVES · AI-powered Viva Exam System</div>
    </footer>

    <div class="confirm-backdrop" id="confirm-backdrop" aria-hidden="true">
        <div class="confirm-dialog" role="alertdialog" aria-modal="true"
             aria-labelledby="confirm-title" aria-describedby="confirm-message">
            <p class="confirm-dialog__message" id="confirm-message"></p>
            <div class="confirm-dialog__actions">
                <button class="btn btn-outline-secondary confirm-dialog__cancel" id="confirm-cancel">Huỷ</button>
                <button class="btn btn-danger confirm-dialog__ok" id="confirm-ok">Xác nhận</button>
            </div>
        </div>
    </div>

    <div class="realtime-notice" id="realtime-notice" role="status" aria-live="polite" hidden>
        <span id="realtime-notice-message">Danh sách vừa thay đổi.</span>
        <button type="button" id="realtime-notice-refresh">Cập nhật</button>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @if (isSignedIn)
    {
        <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    }
    <script src="~/js/exam-realtime.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @* Drives _SearchableSelect and the student combobox; no-ops on pages without them. *@
    <script src="~/js/combobox.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>