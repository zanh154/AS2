@model AssignmentPRN.Presentation.ViewModels.CandidateResultViewModel
@{
    var candidate = Model.Candidate;
    var paper = candidate.Paper;
    var isCompleted = candidate.Status == CandidateStatus.Completed;
    decimal? headerScore = !isCompleted ? null : (Model.Review is { } rev ? rev.FinalScore : paper.Score);
    var hasMcqSelections = paper.Questions.Any(q => q.SelectedOptionId.HasValue);
}

<div class="exam-result-page">
    <div class="page-header exam-result-header">
        <div>
            <a class="back-link" asp-page="/ExamResults/Index" asp-route-id="@candidate.ExamId">
                <partial name="/Pages/Shared/_Icon.cshtml" model="@("arrow-left")" /> Quay lại bảng điểm
            </a>
            <span class="eyebrow">@paper.CourseCode · @paper.ExamName</span>
            <h1>@candidate.StudentName</h1>
            <p>
                @candidate.StudentEmail ·
                <span class="status-chip @ExamSessionText.ChipModifier(candidate.Status)">@ExamSessionText.Status(candidate.Status)</span>
            </p>
        </div>
        <div class="exam-result-score" aria-label="Điểm @ExamResultText.Score(headerScore) trên 10">
            <span>Điểm</span>
            <strong>@ExamResultText.Score(headerScore)</strong>
            <small>/ 10</small>
        </div>
    </div>

    <section class="metric-row">
        <div class="metric-card"><span>Giờ thi</span><strong>@(candidate.ScheduledTime?.ToString("HH:mm") ?? "—")</strong></div>
        <div class="metric-card"><span>Bắt đầu</span><strong>@(candidate.StartedAt?.ToString("HH:mm") ?? "—")</strong></div>
        <div class="metric-card"><span>Nộp bài</span><strong>@(candidate.FinishedAt?.ToString("HH:mm") ?? "—")</strong></div>
        @if (hasMcqSelections || Model.Review?.Answers.Count is null or 0)
        {
            <div class="metric-card"><span>Câu chính đúng</span><strong>@ExamResultText.Ratio(paper.MainQuestions.Count(q => q.IsCorrect), paper.MainQuestions.Count)</strong></div>
            <div class="metric-card"><span>Đào sâu đúng</span><strong>@ExamResultText.Ratio(paper.FollowUpCorrectCount, paper.FollowUpQuestions.Count)</strong></div>
        }
    </section>

    @if (!isCompleted)
    {
        <div class="info-note">
            Sinh viên chưa hoàn thành bài, điểm chưa được tính. Nội dung dưới đây là những gì đã lưu đến lúc này.
        </div>
    }

    @if (Model.ReviewError is not null)
    {
        <div class="info-note">Không đọc được đánh giá của AI: @Model.ReviewError</div>
    }
    else if (Model.Review is { } review)
    {
        <div class="content-card exam-result-ai">
            <div class="section-heading">
                <div>
                    <h2>AI đề xuất &amp; điểm chốt</h2>
                    <p class="text-muted">
                        AI tự động chấm sau khi sinh viên nộp bài. Giảng viên có thể chỉnh sửa linh hoạt từng câu hoặc điểm tổng rồi lưu.
                    </p>
                </div>
                @if (isCompleted && !review.IsDisqualified && review.Answers.Count > 0)
                {
                    var hasAnyAiScore = review.Answers.Any(a => !a.NotGraded);
                    <form method="post" asp-page="/ExamResults/Candidate" asp-page-handler="GradeWithGemini" asp-route-id="@candidate.Paper.CandidateId">
                        <button type="submit" class="btn btn-outline-primary text-nowrap">
                            @(hasAnyAiScore ? "Chấm lại bằng Gemini AI" : "Chấm ngay bằng Gemini AI")
                        </button>
                    </form>
                }
            </div>
            <p class="info-note" id="grading-live-status" role="status" aria-live="polite" hidden></p>

            @if (review.IsDisqualified)
            {
                <div class="proctor-alert proctor-alert--danger" role="alert">
                    <span class="proctor-alert__badge">GIAN LẬN · CHẤM DỨT BÀI THI · 0 ĐIỂM</span>
                    <strong>Sinh viên có dấu hiệu gian lận (rời màn hình / chuyển tab @review.CheatViolationCount lần, vượt quá 3/3 cảnh báo).</strong>
                    <p>Hệ thống đã tự động chấm dứt bài thi và ghi nhận 0 điểm. Giảng viên vẫn có thể kiểm tra nhật ký vi phạm bên dưới.</p>
                </div>
            }
            else if (review.CheatViolationCount > 0)
            {
                <div class="proctor-alert proctor-alert--warning" role="status">
                    <span class="proctor-alert__badge">CẢNH BÁO GIAN LẬN · @review.CheatViolationCount / 3</span>
                    <strong>Sinh viên có @review.CheatViolationCount lần rời màn hình / chuyển tab trong lúc thi.</strong>
                    <p>Xem chi tiết các mốc thời gian rời màn hình tại mục Lịch sử bên dưới.</p>
                </div>
            }

            <div class="metric-row">
                <div class="metric-card"><span>AI đề xuất</span><strong>@ExamResultText.Score(review.AiScore)</strong></div>
                <div class="metric-card"><span>Tổng điểm các câu</span><strong id="flex-total-display">@(review.QuestionTotalScore is { } qt ? $"{qt:0.##} / {review.GradedQuestionCount * 10}" : "—")</strong></div>
                <div class="metric-card"><span>Trung bình mỗi câu</span><strong id="flex-avg-display">@(review.QuestionAverageScore is { } qa ? $"{qa:0.##} / 10" : "—")</strong></div>
                <div class="metric-card"><span>Giảng viên chốt</span><strong>@ExamResultText.Score(review.LecturerScore)</strong></div>
                <div class="metric-card"><span>Điểm cuối</span><strong>@ExamResultText.Score(review.FinalScore)</strong></div>
            </div>

            @if (review.FinalizedAt is { } finalizedAt)
            {
                <p class="text-muted">Chốt bởi @(review.FinalizedByName ?? "—") lúc @finalizedAt.ToString("HH:mm dd/MM/yyyy").</p>
            }

            <form method="post" asp-page="/ExamResults/Candidate" asp-page-handler="Adjust" asp-route-id="@candidate.Paper.CandidateId"
                  class="exam-result-adjust" id="flexible-grading-form">
                @if (review.Answers.Count > 0)
                {
                    <div class="form-row">
                        <label>Chấm linh hoạt từng câu (tự động cập nhật điểm tổng &amp; trung bình)</label>
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Câu hỏi</th>
                                    <th>AI chấm</th>
                                    <th>Điểm giảng viên (0–10)</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var answer in review.Answers)
                            {
                                <tr>
                                    <td>
                                        <strong>Câu @answer.OrderNo</strong>
                                        <div class="text-muted small text-truncate" style="max-width: 360px;" title="@answer.QuestionText">@answer.QuestionText</div>
                                    </td>
                                    <td class="cell-nowrap">@ExamResultText.Score(answer.AiScore)</td>
                                    <td style="width: 150px;">
                                        <input type="hidden" name="questionOrder" value="@answer.OrderNo" />
                                        <input type="number" class="form-control" name="questionScore"
                                               min="0" max="10" step="0.01" inputmode="decimal"
                                               data-flex-q-input
                                               value="@answer.AiScore?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                               placeholder="0 – 10" />
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                <div class="form-row">
                    <label for="lecturer-score">Điểm giảng viên chốt tổng (0–10)</label>
                    <input class="form-control" id="lecturer-score" name="score" type="number" inputmode="decimal"
                           min="0" max="10" step="0.01" value="@review.LecturerScore?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                    <small class="text-muted">Tự động tính trung bình khi bạn chỉnh điểm từng câu bên trên, hoặc nhập trực tiếp điểm bạn muốn chốt.</small>
                </div>
                <div class="form-row">
                    <label for="lecturer-comment">Nhận xét của giảng viên</label>
                    <textarea class="form-control" id="lecturer-comment" name="comment" rows="3"
                              maxlength="2000">@review.LecturerComment</textarea>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-primary" type="submit">Lưu điểm chốt</button>
                    @if (review.LecturerScore is not null)
                    {
                        <button class="btn btn-outline-secondary" type="submit" name="clearOverride" value="true">Dùng lại điểm AI</button>
                    }
                </div>
            </form>
            <script>
            (() => {
              const form = document.getElementById("flexible-grading-form");
              if (!form) return;
              const qInputs = [...form.querySelectorAll("[data-flex-q-input]")];
              const scoreInput = document.getElementById("lecturer-score");
              const totalEl = document.getElementById("flex-total-display");
              const avgEl = document.getElementById("flex-avg-display");
              const syncFromQuestions = () => {
                const vals = qInputs.map(i => parseFloat(i.value)).filter(v => !Number.isNaN(v) && v >= 0 && v <= 10);
                if (vals.length === 0) {
                  if (totalEl) totalEl.textContent = "—";
                  if (avgEl) avgEl.textContent = "—";
                  return;
                }
                const sum = vals.reduce((a, b) => a + b, 0);
                const avg = Math.round((sum / vals.length) * 100) / 100;
                if (totalEl) totalEl.textContent = `${Math.round(sum * 100) / 100} / ${vals.length * 10}`;
                if (avgEl) avgEl.textContent = `${avg} / 10`;
                if (scoreInput) scoreInput.value = String(avg);
              };
              qInputs.forEach(inp => inp.addEventListener("input", syncFromQuestions));
            })();
            </script>

            @if (review.Answers.Count > 0)
            {
                <h3 class="mt-4 mb-3">Chi tiết bài làm &amp; đối chiếu đáp án từng câu</h3>
                <ol class="exam-result-ai-answers">
                    @foreach (var answer in review.Answers)
                    {
                        <li>
                            <h3>Câu @answer.OrderNo · AI chấm: @ExamResultText.Score(answer.AiScore)</h3>
                            <p class="fw-medium mb-2">@answer.QuestionText</p>

                            <div class="exam-result-expected mb-2">
                                <span>Câu trả lời của sinh viên</span>
                                <p>@(string.IsNullOrWhiteSpace(answer.Transcript) ? "(Sinh viên không nói / chưa có bản ghi)" : answer.Transcript)</p>
                            </div>

                            <div class="exam-result-expected mb-3">
                                <span>Đáp án chuẩn có sẵn</span>
                                <p>@(string.IsNullOrWhiteSpace(answer.ExpectedAnswer) ? "(Câu hỏi chưa cài đặt đáp án chuẩn)" : answer.ExpectedAnswer)</p>
                            </div>

                            @if (answer.NotGraded)
                            {
                                <p class="info-note">Câu trả lời chưa đủ nội dung để AI chấm hoặc chưa nhận được phản hồi từ AI. Giảng viên có thể nhập điểm trực tiếp ở trên.</p>
                            }
                            else
                            {
                                @if (!string.IsNullOrWhiteSpace(answer.Feedback))
                                {
                                    <p class="info-note">@answer.Feedback</p>
                                }
                                @if (answer.Criteria.Count > 0)
                                {
                                    <table class="data-table">
                                        <thead>
                                            <tr><th>Tiêu chí</th><th>Điểm</th><th>Nhận xét</th></tr>
                                        </thead>
                                        <tbody>
                                        @foreach (var criterion in answer.Criteria)
                                        {
                                            <tr>
                                                <td>@criterion.Name</td>
                                                <td class="cell-nowrap">@criterion.Awarded.ToString("0.##") / @criterion.MaxScore.ToString("0.##")</td>
                                                <td>@(criterion.Comment ?? "—")</td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                }
                                @if (!string.IsNullOrWhiteSpace(answer.Strengths))
                                {
                                    <p><strong>Điểm mạnh:</strong> @answer.Strengths</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(answer.Weaknesses))
                                {
                                    <p><strong>Điểm yếu:</strong> @answer.Weaknesses</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(answer.MissingPoints))
                                {
                                    <p><strong>Ý còn thiếu:</strong> @answer.MissingPoints</p>
                                }
                            }
                            @if (answer.Probes.Count > 0)
                            {
                                <h4>Câu hỏi đào sâu</h4>
                                <ul>
                                    @foreach (var probe in answer.Probes)
                                    {
                                        <li>@probe.Question<br /><span class="text-muted">Trả lời: @(string.IsNullOrWhiteSpace(probe.Transcript) ? "Sinh viên không trả lời." : probe.Transcript)</span></li>
                                    }
                                </ul>
                            }
                        </li>
                    }
                </ol>
            }

            @if (review.Trail.Count > 0)
            {
                <h3>Lịch sử thay đổi điểm &amp; giám sát</h3>
                <ul class="exam-result-trail">
                    @foreach (var entry in review.Trail)
                    {
                        <li>
                            <span class="text-muted">@entry.At.ToString("HH:mm dd/MM/yyyy")</span> ·
                            @(entry.ByName ?? "—") · @entry.Description
                        </li>
                    }
                </ul>
            }
        </div>
    }

    @if (paper.Questions.Count == 0)
    {
        <div class="content-card">
            <div class="empty-state">
                <div class="empty-icon"><partial name="/Pages/Shared/_Icon.cshtml" model="@("question")" /></div>
                <h2>Chưa có bài làm</h2>
                <p>Sinh viên chưa vào thi nên chưa được phát đề.</p>
            </div>
        </div>
    }
    else if (hasMcqSelections || Model.Review?.Answers.Count is null or 0)
    {
        <div class="content-card exam-result-review">
            <div class="section-heading">
                <div>
                    <h2>Vòng 1 · Câu hỏi chính</h2>
                    <p class="text-muted">Phương án sinh viên chọn được đánh dấu; câu sai hiển thị đáp án đúng.</p>
                </div>
            </div>
            <ol class="exam-room-questions">
                @foreach (var question in paper.MainQuestions)
                {
                    <partial name="/Pages/Shared/_ExamResultQuestion.cshtml" model="@(new ExamResultQuestionViewModel
                    {
                        Question = question,
                        PickedLabel = "Sinh viên chọn"
                    })" />
                }
            </ol>
        </div>

        @if (paper.FollowUpQuestions.Count > 0)
        {
            <div class="content-card exam-result-review">
                <div class="section-heading">
                    <div>
                        <h2>Vòng 2 · Câu hỏi đào sâu</h2>
                        <p class="text-muted">Mỗi câu đào sâu có trọng số bằng nửa câu chính.</p>
                    </div>
                </div>
                <ol class="exam-room-questions">
                    @foreach (var question in paper.FollowUpQuestions)
                    {
                        <partial name="/Pages/Shared/_ExamResultQuestion.cshtml" model="@(new ExamResultQuestionViewModel
                        {
                            Question = question,
                            ParentOrderNo = Model.OrderOf(question.ParentExamQuestionId),
                            PickedLabel = "Sinh viên chọn"
                        })" />
                    }
                </ol>
            </div>
        }
    }
</div>
