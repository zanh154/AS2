@page "{id:int}"
@model AssignmentPRN.Presentation.Pages.Documents.Questions.ReviewModel
@{
    ViewData["Title"] = Model.IsNew ? "Duyệt câu hỏi mới" : "Xem/Xét duyệt câu hỏi";
}

<div class="page-header">
    <h1>@(Model.IsNew ? "Duyệt câu hỏi mới" : "Xem/Xét duyệt câu hỏi")</h1>
    <a asp-page="Index" asp-route-documentId="@Model.DocumentId" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (Model.Success != null)
{
    <div class="alert alert-success">@Model.Success</div>
}

@if (Model.Question is not null)
{
<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5>Nội dung câu hỏi</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <fieldset disabled="@(!Model.IsNew)">
                    <input type="hidden" name="questionId" value="@Model.Question.QuestionId" />
                    <input type="hidden" name="documentId" value="@Model.DocumentId" />

                    <div class="mb-3">
                        <label class="form-label">Câu hỏi <span class="text-danger">*</span></label>
                        <textarea name="questionText" class="form-control" rows="4" required>@Model.Question.QuestionText</textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Đáp án đúng</label>
                        <textarea name="answerKey" class="form-control" rows="3">@Model.Question.AnswerKey</textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Giải thích</label>
                        <textarea name="explanation" class="form-control" rows="3">@Model.Question.Explanation</textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Mức độ Bloom</label>
                            <select name="bloomLevel" class="form-select">
                                <option value="1" selected="@(Model.Question.BloomLevel == AssignmentPRN.DataAccess.Entities.DocumentBloomLevel.Remember)">Remember (Nhớ)</option>
                                <option value="2" selected="@(Model.Question.BloomLevel == AssignmentPRN.DataAccess.Entities.DocumentBloomLevel.Understand)">Understand (Hiểu)</option>
                                <option value="3" selected="@(Model.Question.BloomLevel == AssignmentPRN.DataAccess.Entities.DocumentBloomLevel.Apply)">Apply (Áp dụng)</option>
                                <option value="4" selected="@(Model.Question.BloomLevel == AssignmentPRN.DataAccess.Entities.DocumentBloomLevel.Analyze)">Analyze (Phân tích)</option>
                                <option value="5" selected="@(Model.Question.BloomLevel == AssignmentPRN.DataAccess.Entities.DocumentBloomLevel.Evaluate)">Evaluate (Đánh giá)</option>
                                <option value="6" selected="@(Model.Question.BloomLevel == AssignmentPRN.DataAccess.Entities.DocumentBloomLevel.Create)">Create (Sáng tạo)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Chủ đề</label>
                            <input type="text" name="topic" class="form-control" value="@Model.Question.Topic" placeholder="Ví dụ: Lập trình hướng đối tượng" />
                        </div>
                    </div>

                    @if (Model.IsNew)
                    {
                        <div class="mb-3">
                            <label class="form-label">Quyết định <span class="text-danger">*</span></label>
                            <div class="btn-group w-100" role="group">
                                <input type="radio" class="btn-check" name="decision" id="approve" value="1" checked />
                                <label class="btn btn-success" for="approve"><i class="bi bi-check-circle"></i> Duyệt</label>
                                <input type="radio" class="btn-check" name="decision" id="reject" value="2" />
                                <label class="btn btn-danger" for="reject"><i class="bi bi-x-circle"></i> Từ chối</label>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">Trạng thái hiện tại</label>
                            <div class="form-control-plaintext">
                                <span class="badge @Model.GetQuestionStatusBadgeClass(Model.Question.Status)">
                                    @Model.GetQuestionStatusText(Model.Question.Status)
                                </span>
                                @if (Model.Question.Status != AssignmentPRN.DataAccess.Entities.GeneratedQuestionStatus.PendingReview)
                                {
                                    <span class="ms-2 text-muted">
                                        Đã duyệt bởi @Model.Question.ReviewedByName vào @Model.Question.ReviewedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                }
                            </div>
                        </div>

                        @if (Model.Question.Status == AssignmentPRN.DataAccess.Entities.GeneratedQuestionStatus.PendingReview)
                        {
                            <div class="mb-3">
                                <label class="form-label">Quyết định <span class="text-danger">*</span></label>
                                <div class="btn-group w-100" role="group">
                                    <input type="radio" class="btn-check" name="decision" id="approve" value="1" checked />
                                    <label class="btn btn-success" for="approve"><i class="bi bi-check-circle"></i> Duyệt</label>
                                    <input type="radio" class="btn-check" name="decision" id="reject" value="2" />
                                    <label class="btn btn-danger" for="reject"><i class="bi bi-x-circle"></i> Từ chối</label>
                                </div>
                            </div>
                        }
                    }

                    <div class="mb-3">
                        <label class="form-label">Ghi chú duyệt (tùy chọn)</label>
                        <textarea name="notes" class="form-control" rows="2" placeholder="Lý do duyệt/từ chối..."></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Lưu quyết định
                        </button>
                        <a asp-page="Index" asp-route-documentId="@Model.DocumentId" class="btn btn-secondary">Hủy</a>
                    </div>
                    </fieldset>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5>Thông tin</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">ID</dt>
                    <dd class="col-sm-8">@Model.Question.QuestionId</dd>

                    <dt class="col-sm-4">Tài liệu gốc</dt>
                    <dd class="col-sm-8">@Model.Question.DocumentId</dd>

                    <dt class="col-sm-4">Ngày tạo</dt>
                    <dd class="col-sm-8">@Model.Question.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-4">Trạng thái</dt>
                    <dd class="col-sm-8">
                        <span class="badge @Model.GetQuestionStatusBadgeClass(Model.Question.Status)">
                            @Model.GetQuestionStatusText(Model.Question.Status)
                        </span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</div>
}
