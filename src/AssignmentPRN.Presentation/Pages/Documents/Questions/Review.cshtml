@page "{id:int}"
@model AssignmentPRN.Presentation.Pages.Documents.Questions.ReviewModel
@{
    ViewData["Title"] = Model.IsNew ? "Duyệt câu hỏi mới" : "Xem/Xét duyệt câu hỏi";
}

<div class="page-header">
    <div>
        <span class="eyebrow">Tài liệu &amp; AI</span>
        <h1>@(Model.IsNew ? "Duyệt câu hỏi mới" : "Xem/Xét duyệt câu hỏi")</h1>
        <p>Kiểm tra nội dung AI đề xuất trước khi đưa câu hỏi vào ngân hàng.</p>
    </div>
    <a asp-page="Index" asp-route-documentId="@Model.DocumentId" class="btn btn-outline-secondary">
        <partial name="/Pages/Shared/_Icon.cshtml" model="@("arrow-left")" /> Quay lại danh sách
    </a>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (Model.Success != null)
{
    <div class="alert alert-success">@Model.Success</div>
}

@if (Model.Question is not null)
{
@if (Model.Question.BankQuestionId is int bankId)
{
    <div class="alert alert-info">Câu hỏi đã có trong ngân hàng. <a href="@Url.Page("/Rubrics/Edit", new { questionId = bankId })">Cấu hình rubric chấm điểm</a> trước khi sử dụng cho bài vấn đáp.</div>
}
<div class="question-review-layout">
    <div class="question-review-main">
        <div class="content-card question-review-card">
            <div class="question-review-card__header">
                <div>
                    <span class="eyebrow">Nội dung</span>
                    <h2>Câu hỏi và đáp án</h2>
                </div>
            </div>
            <div class="question-review-card__body">
                <form method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <fieldset disabled="@(!Model.IsNew)">
                    <input type="hidden" name="questionId" value="@Model.Question.QuestionId" />
                    <input type="hidden" name="documentId" value="@Model.DocumentId" />

                    <div class="mb-3">
                        <label class="form-label">Câu hỏi <span class="text-danger">*</span></label>
                        <textarea name="questionText" class="form-control" rows="4" required>@Model.Question.QuestionText</textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Đáp án đúng</label>
                        <textarea name="answerKey" class="form-control" rows="3">@Model.Question.AnswerKey</textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Giải thích</label>
                        <textarea name="explanation" class="form-control" rows="3">@Model.Question.Explanation</textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Mức độ Bloom</label>
                            <select name="bloomLevel" class="form-select">
                                <option value="1" selected="@(Model.Question.BloomLevel == AssignmentPRN.Business.Interfaces.DocumentBloomLevel.Remember)">Remember (Nhớ)</option>
                                <option value="2" selected="@(Model.Question.BloomLevel == AssignmentPRN.Business.Interfaces.DocumentBloomLevel.Understand)">Understand (Hiểu)</option>
                                <option value="3" selected="@(Model.Question.BloomLevel == AssignmentPRN.Business.Interfaces.DocumentBloomLevel.Apply)">Apply (Áp dụng)</option>
                                <option value="4" selected="@(Model.Question.BloomLevel == AssignmentPRN.Business.Interfaces.DocumentBloomLevel.Analyze)">Analyze (Phân tích)</option>
                                <option value="5" selected="@(Model.Question.BloomLevel == AssignmentPRN.Business.Interfaces.DocumentBloomLevel.Evaluate)">Evaluate (Đánh giá)</option>
                                <option value="6" selected="@(Model.Question.BloomLevel == AssignmentPRN.Business.Interfaces.DocumentBloomLevel.Create)">Create (Sáng tạo)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Chủ đề AI gợi ý</label>
                            <input type="text" name="topic" class="form-control" value="@Model.Question.Topic" placeholder="Ví dụ: Lập trình hướng đối tượng" />
                        </div>
                    </div>

                    @if (Model.Question.BankQuestionId is null)
                    {
                        <div class="mb-3">
                            <label class="form-label" for="materialId">Chủ đề trong ngân hàng (tài liệu môn)</label>
                            <select id="materialId" name="materialId" class="form-select" asp-items="Model.MaterialOptions">
                                @if (!Model.HasSourceMaterial)
                                {
                                    <option value="">Không gắn chủ đề</option>
                                }
                            </select>
                            <p class="form-text">Mặc định là tài liệu đã sinh ra câu hỏi. Câu hỏi được duyệt sẽ vào ngân hàng với chủ đề này; câu đào sâu chỉ bám theo câu có chủ đề.
                                <a asp-page="/CourseMaterials/Index">Quản lý tài liệu môn</a></p>
                        </div>
                    }

                    @if (Model.IsNew)
                    {
                        <div class="mb-3">
                            <label class="form-label">Quyết định <span class="text-danger">*</span></label>
                            <div class="review-decision-grid" role="group" aria-label="Quyết định duyệt">
                                <input type="radio" class="btn-check" name="decision" id="approve" value="1" checked />
                                <label class="review-decision review-decision--approve" for="approve">
                                    <strong>Duyệt câu hỏi</strong><span>Đưa vào ngân hàng câu hỏi</span>
                                </label>
                                <input type="radio" class="btn-check" name="decision" id="reject" value="2" />
                                <label class="review-decision review-decision--reject" for="reject">
                                    <strong>Từ chối</strong><span>Không sử dụng nội dung này</span>
                                </label>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">Trạng thái hiện tại</label>
                            <div class="form-control-plaintext">
                                <span class="badge @Model.GetQuestionStatusBadgeClass(Model.Question.Status)">
                                    @Model.GetQuestionStatusText(Model.Question.Status)
                                </span>
                                @if (Model.Question.Status != AssignmentPRN.Business.Interfaces.GeneratedQuestionStatus.PendingReview)
                                {
                                    <span class="ms-2 text-muted">
                                        Đã duyệt bởi @Model.Question.ReviewedByName vào @Model.Question.ReviewedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                }
                            </div>
                        </div>

                        @if (Model.Question.Status == AssignmentPRN.Business.Interfaces.GeneratedQuestionStatus.PendingReview)
                        {
                            <div class="mb-3">
                                <label class="form-label">Quyết định <span class="text-danger">*</span></label>
                                <div class="review-decision-grid" role="group" aria-label="Quyết định duyệt">
                                    <input type="radio" class="btn-check" name="decision" id="approve" value="1" checked />
                                    <label class="review-decision review-decision--approve" for="approve">
                                        <strong>Duyệt câu hỏi</strong><span>Đưa vào ngân hàng câu hỏi</span>
                                    </label>
                                    <input type="radio" class="btn-check" name="decision" id="reject" value="2" />
                                    <label class="review-decision review-decision--reject" for="reject">
                                        <strong>Từ chối</strong><span>Không sử dụng nội dung này</span>
                                    </label>
                                </div>
                            </div>
                        }
                    }

                    <div class="mb-3">
                        <label class="form-label">Ghi chú duyệt (tùy chọn)</label>
                        <textarea name="notes" class="form-control" rows="2" placeholder="Lý do duyệt/từ chối..."></textarea>
                    </div>

                    <div class="review-actions">
                        <button type="submit" class="btn btn-primary">
                            Lưu quyết định
                        </button>
                        <a asp-page="Index" asp-route-documentId="@Model.DocumentId" class="btn btn-outline-secondary">Hủy</a>
                    </div>
                    </fieldset>
                </form>
            </div>
        </div>
    </div>

    <aside class="question-review-aside">
        <div class="content-card question-review-card question-review-card--meta">
            <div class="question-review-card__header">
                <div>
                    <span class="eyebrow">Tổng quan</span>
                    <h2>Thông tin</h2>
                </div>
            </div>
            <div class="question-review-card__body">
                <dl class="review-meta">
                    <dt>ID câu hỏi</dt>
                    <dd>#@Model.Question.QuestionId</dd>

                    <dt>Tài liệu gốc</dt>
                    <dd>#@Model.Question.DocumentId</dd>

                    <dt>Ngày tạo</dt>
                    <dd>@Model.Question.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt>Trạng thái</dt>
                    <dd>
                        <span class="badge @Model.GetQuestionStatusBadgeClass(Model.Question.Status)">
                            @Model.GetQuestionStatusText(Model.Question.Status)
                        </span>
                    </dd>
                </dl>
            </div>
        </div>
    </aside>
</div>
}
