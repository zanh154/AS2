@page "{id:int}"
@model AssignmentPRN.Presentation.Pages.Documents.DetailsModel
@{
    ViewData["Title"] = "Chi tiết tài liệu";
}

<div class="page-header">
    <h1>Chi tiết tài liệu</h1>
    <a asp-page="Index" asp-route-courseId="@Model.Document?.CourseId" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (Model.Document != null)
{
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Thông tin cơ bản</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Tên file</dt>
                        <dd class="col-sm-9">@Model.Document.FileName</dd>

                        <dt class="col-sm-3">Loại file</dt>
                        <dd class="col-sm-9"><span class="badge bg-secondary">@Model.Document.ContentType</span></dd>

                        <dt class="col-sm-3">Kích thước</dt>
                        <dd class="col-sm-9">@Model.FormatFileSize(Model.Document.FileSize)</dd>

                        <dt class="col-sm-3">Môn học</dt>
                        <dd class="col-sm-9">@Model.Document.CourseCode - @Model.Document.CourseName</dd>

                        <dt class="col-sm-3">Người tải lên</dt>
                        <dd class="col-sm-9">@Model.Document.UploadedByName</dd>

                        <dt class="col-sm-3">Ngày tải lên</dt>
                        <dd class="col-sm-9">@Model.Document.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Trạng thái xử lý</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Trạng thái</dt>
                        <dd class="col-sm-8">
                            <span class="badge @Model.GetStatusBadgeClass(Model.Document.Status) fs-6">
                                @Model.GetStatusText(Model.Document.Status)
                            </span>
                        </dd>

                        @if (Model.Document.Status == AssignmentPRN.DataAccess.Entities.DocumentStatus.Processing)
                        {
                            <dt class="col-sm-4">Tiến độ</dt>
                            <dd class="col-sm-8">
                                <div class="progress" style="height: 24px;">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated"
                                         role="progressbar"
                                         style="width: 100%"

                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                        Đang xử lý…
                                    </div>
                                </div>
                                <small class="text-muted">Đang trích xuất văn bản, chia chunk và tạo embedding...</small>
                            </dd>
                        }

                        @if (Model.Document.Status == AssignmentPRN.DataAccess.Entities.DocumentStatus.Completed)
                        {
                            <dt class="col-sm-4">Hoàn tất lúc</dt>
                            <dd class="col-sm-8">@Model.Document.ProcessedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                            <dt class="col-sm-4">Số chunks</dt>
                            <dd class="col-sm-8">@Model.Document.ChunkCount</dd>
                            <dt class="col-sm-4">Số câu hỏi đã sinh</dt>
                            <dd class="col-sm-8">@Model.Document.QuestionCount</dd>
                        }

                        @if (Model.Document.Status == AssignmentPRN.DataAccess.Entities.DocumentStatus.Failed)
                        {
                            <dt class="col-sm-4">Lỗi</dt>
                            <dd class="col-sm-8 text-danger">@Model.Document.ErrorMessage</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Document.Status == AssignmentPRN.DataAccess.Entities.DocumentStatus.Completed)
    {
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Câu hỏi đã sinh</h5>
                <a asp-page="Questions/Index" asp-route-documentId="@Model.Document.DocumentId" class="btn btn-sm btn-primary">
                    <i class="bi bi-question-circle"></i> Quản lý câu hỏi
                </a>
            </div>
            <div class="card-body">
                @if (Model.Questions.Count == 0)
                {
                    <p class="text-muted">Chưa có câu hỏi nào. Nhấn "Sinh câu hỏi" để tạo mới.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    <th>Nội dung câu hỏi</th>
                                    <th>Mức độ Bloom</th>
                                    <th>Chủ đề</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var q in Model.Questions.Take(10))
                                {
                                    <tr>
                                        <td>@q.QuestionText[..Math.Min(100, q.QuestionText.Length)]@(q.QuestionText.Length > 100 ? "..." : "")</td>
                                        <td><span class="badge bg-info">@q.BloomLevel</span></td>
                                        <td>@(q.Topic ?? "-")</td>
                                        <td><span class="badge @Model.GetQuestionStatusBadgeClass(q.Status)">@Model.GetQuestionStatusText(q.Status)</span></td>
                                        <td>
                                            <a asp-page="Questions/Review" asp-route-id="@q.QuestionId" asp-route-documentId="@Model.Document.DocumentId" class="btn btn-sm btn-outline-primary">Xem/Duyệt</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (Model.Questions.Count > 10)
                    {
                        <div class="text-center">
                            <a asp-page="Questions/Index" asp-route-documentId="@Model.Document.DocumentId" class="btn btn-link">
                                Xem tất cả @Model.Questions.Count câu hỏi
                            </a>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5>Sinh câu hỏi mới</h5>
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="GenerateQuestions">
                    <input type="hidden" name="documentId" value="@Model.Document.DocumentId" />
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Số lượng</label>
                            <input type="number" name="count" class="form-control" value="5" min="1" max="20" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Mức độ Bloom</label>
                            <select name="bloomLevel" class="form-select">
                                <option value="">Tự do</option>
                                <option value="1">Remember (Nhớ)</option>
                                <option value="2">Understand (Hiểu)</option>
                                <option value="3" selected>Apply (Áp dụng)</option>
                                <option value="4">Analyze (Phân tích)</option>
                                <option value="5">Evaluate (Đánh giá)</option>
                                <option value="6">Create (Sáng tạo)</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Chủ đề (tùy chọn)</label>
                            <input type="text" name="topic" class="form-control" placeholder="Ví dụ: Lập trình hướng đối tượng" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-success w-100">
                                <i class="bi bi-magic"></i> Sinh câu hỏi
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }
}


@if (Model.Document is { } doc) {
<script src="~/js/document-realtime.js" asp-append-version="true" defer data-document-id="@doc.DocumentId" data-document-status="@doc.Status"></script>
}
