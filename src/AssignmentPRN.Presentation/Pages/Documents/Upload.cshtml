@page
@model AssignmentPRN.Presentation.Pages.Documents.UploadModel
@{
    ViewData["Title"] = "Tải lên tài liệu";
}

<div class="page-header">
    <h1>Tải lên tài liệu mới</h1>
    <a asp-page="Index" asp-route-courseId="@Model.CourseId" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<div class="card">
    <div class="card-header">
        <h5>Thông tin tải lên</h5>
    </div>
    <div class="card-body">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Input.File" class="form-label">Chọn file <span class="text-danger">*</span></label>
                <input asp-for="Input.File" type="file" class="form-control" accept=".pdf,.docx,.pptx" required />
                <span asp-validation-for="Input.File" class="text-danger"></span>
                <div class="form-text">
                    Định dạng hỗ trợ: PDF, DOCX, PPTX. Kích thước tối đa: @Model.MaxFileSizeMB MB.
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Môn học</label>
                <input type="text" class="form-control" value="@Model.CourseName" readonly />
                <input type="hidden" asp-for="Input.CourseId" />
            </div>

            <button type="submit" class="btn btn-primary" id="uploadBtn">
                <i class="bi bi-upload"></i> Tải lên và xử lý
            </button>
            <a asp-page="Index" asp-route-courseId="@Model.CourseId" class="btn btn-secondary">Hủy</a>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const uploadButton = document.getElementById('uploadBtn');
        const uploadLabel = uploadButton.innerHTML;
        uploadButton.form.addEventListener('submit', function(e) {
            const fileInput = document.querySelector('input[type="file"]');
            if (!fileInput.files.length) {
                e.preventDefault();
                alert('Vui lòng chọn file.');
                return;
            }

            if (uploadButton.disabled) { e.preventDefault(); return; }
            uploadButton.disabled = true;
            uploadButton.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang tải lên...';
        });
        window.addEventListener('pageshow', () => {
            uploadButton.disabled = false;
            uploadButton.innerHTML = uploadLabel;
        });
    </script>
}