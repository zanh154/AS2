@model (int Index, AssignmentPRN.Presentation.Pages.Rubrics.EditModel.RubricCriteriaRow Criteria)
@{
    var prefix = $"Criteria[{Model.Index}]";
}
<article class="rubric-criterion" data-index="@Model.Index">
    <div class="rubric-criterion__number" aria-hidden="true">@(Model.Index + 1)</div>
    <div class="rubric-criterion__fields">
            <div class="rubric-field rubric-field--name">
                <label class="form-label">Tên tiêu chí <span class="text-danger">*</span></label>
                <input type="text" name="@($"{prefix}.CriteriaName")" value="@Model.Criteria.CriteriaName" class="form-control" required maxlength="200" />
                <input type="hidden" name="@($"{prefix}.CriteriaId")" value="@Model.Criteria.CriteriaId" />
            </div>
            <div class="rubric-field rubric-field--description">
                <label class="form-label">Mô tả</label>
                <textarea name="@($"{prefix}.Description")" class="form-control" rows="2" maxlength="1000">@Model.Criteria.Description</textarea>
            </div>
            <div class="rubric-field rubric-field--score">
                <label class="form-label">Điểm tối đa <span class="text-danger">*</span></label>
                <input type="number" step="0.25" min="0.25" name="@($"{prefix}.MaxScore")" value="@Model.Criteria.MaxScore" class="form-control" required />
            </div>
            <div class="rubric-field rubric-field--order">
                <label class="form-label">Thứ tự</label>
                <input type="number" min="1" name="@($"{prefix}.DisplayOrder")" value="@Model.Criteria.DisplayOrder" class="form-control" required />
            </div>
            <div class="rubric-field rubric-field--remove">
                <span class="form-label" aria-hidden="true">&nbsp;</span>
                <button type="submit" name="index" value="@Model.Index" asp-page="/Rubrics/Edit" asp-page-handler="RemoveCriterion" class="btn btn-outline-danger btn-icon" title="Xoá tiêu chí này" aria-label="Xoá tiêu chí @(Model.Index + 1)">
                    <partial name="/Pages/Shared/_Icon.cshtml" model="@("trash")" />
                </button>
            </div>
    </div>
</article>
