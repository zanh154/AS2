@page
@model AssignmentPRN.Presentation.Pages.Rubrics.EditModel
@{
    ViewData["Title"] = Model.RubricId == 0 ? "Tạo bộ tiêu chí mới" : "Sửa bộ tiêu chí";
    var isCreate = Model.RubricId == 0;
}
<div class="page-header">
    <div>
        <span class="eyebrow">Module 5</span>
        <h1>@(isCreate ? "Tạo bộ tiêu chí mới" : "Sửa bộ tiêu chí")</h1>
        <p>Tổng điểm = tổng điểm các tiêu chí. Mỗi tiêu chí phải có điểm > 0.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="Index" asp-route-courseId="@Model.CourseId" asp-route-term="@Model.Term">Danh sách rubric</a>
        <a class="btn btn-outline-secondary" asp-page="/Questions/Index">Ngân hàng câu hỏi</a>
    </div>
</div>

<form method="post" asp-page="Edit" class="content-card rubric-editor">
    <input type="hidden" name="CourseId" value="@Model.CourseId" />
    <input type="hidden" name="Term" value="@Model.Term" />
    <input type="hidden" name="RubricId" value="@Model.RubricId" />

    <div asp-validation-summary="All" class="text-danger" role="alert"></div>

    <section class="rubric-question-block">
        <label class="form-label" for="QuestionId">Câu hỏi <span class="text-danger">*</span></label>
        @if (Model.QuestionId > 0)
        {
            <input type="hidden" name="QuestionId" value="@Model.QuestionId" />
            <div class="rubric-question-text">@Model.QuestionText</div>
        }
        else
        {
            <select id="QuestionId" name="QuestionId" class="form-select" required>
                <option value="">-- Chọn câu hỏi --</option>
                @foreach (var option in Model.QuestionOptions)
                {
                    <option value="@option.Value">@option.Text</option>
                }
            </select>
            <div class="form-text">Chỉ hiển thị câu hỏi đã duyệt (Approved) và chưa có bộ tiêu chí.</div>
            @if (Model.QuestionOptions.Count == 0)
            {
                <div class="alert alert-info app-alert mt-2 mb-0" role="alert">
                    Mọi câu hỏi đã duyệt đều đã có bộ tiêu chí. Hãy sửa từ danh sách rubric.
                </div>
            }
        }
        @if (Model.LoadError is not null)
        {
            <div class="alert alert-danger app-alert mt-2 mb-0" role="alert">@Model.LoadError</div>
        }
    </section>

    <section class="rubric-criteria-section">
        <div class="section-heading with-action">
            <div>
                <h2>Các tiêu chí chấm điểm</h2>
                <p>Mỗi tiêu chí cần mô tả rõ điều kiện đạt điểm và có điểm tối đa lớn hơn 0.</p>
            </div>
            <span class="status-chip status-chip--muted">@Model.Criteria.Count tiêu chí</span>
        </div>
        <div id="criteria-container" class="rubric-criteria-list">
            @for (var i = 0; i < Model.Criteria.Count; i++)
            {
                <partial name="_CriteriaRow" model="@((i, Model.Criteria[i]))" />
            }
        </div>
        <div class="rubric-criteria-footer">
            <button type="submit" asp-page="Edit" asp-page-handler="AddCriterion" class="btn btn-outline-secondary btn-sm">
                + Thêm tiêu chí
            </button>
            <div class="field-hint">Tổng điểm của rubric được tính từ tổng điểm tối đa của các tiêu chí.</div>
        </div>
    </section>

    <div class="rubric-form-actions">
        <button type="submit" class="btn btn-primary">@(isCreate ? "Tạo" : "Lưu")</button>
        <a class="btn btn-outline-secondary" asp-page="Index" asp-route-courseId="@Model.CourseId" asp-route-term="@Model.Term">Huỷ</a>
    </div>
</form>
