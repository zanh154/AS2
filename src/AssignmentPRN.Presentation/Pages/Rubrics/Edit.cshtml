@page
@model AssignmentPRN.Presentation.Pages.Rubrics.EditModel
@{
    ViewData["Title"] = Model.RubricId == 0 ? "Tạo bộ tiêu chí mới" : "Sửa bộ tiêu chí";
    var isCreate = Model.RubricId == 0;
}
<div class="page-header">
    <div>
        <span class="eyebrow">Module 5</span>
        <h1>@(isCreate ? "Tạo bộ tiêu chí mới" : "Sửa bộ tiêu chí")</h1>
        <p>Tổng điểm = tổng điểm các tiêu chí. Mỗi tiêu chí phải có điểm > 0.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="Index" asp-route-courseId="@ViewData["courseId"]" asp-route-term="@ViewData["term"]">Danh sách rubric</a>
        <a class="btn btn-outline-secondary" asp-controller="Questions" asp-action="Index">Ngân hàng câu hỏi</a>
    </div>
</div>

<form method="post" class="content-card">
    <input type="hidden" name="courseId" value="@ViewData["courseId"]" />
    <input type="hidden" name="term" value="@ViewData["term"]" />
    <input type="hidden" name="RubricId" value="@Model.RubricId" />
    <input type="hidden" name="QuestionId" value="@Model.QuestionId" />

    @if (Model.QuestionId > 0)
    {
        <div class="mb-3">
            <label class="form-label">Câu hỏi</label>
            <div class="form-control-plaintext question-cell">
                @Model.QuestionText
            </div>
        </div>
    }
    else
    {
        <div class="mb-3">
            <label class="form-label" for="QuestionId">Chọn câu hỏi <span class="text-danger">*</span></label>
            <select id="QuestionId" name="QuestionId" class="form-select" required>
                <option value="">-- Chọn câu hỏi --</option>
                @foreach (var option in Model.QuestionOptions)
                {
                    <option value="@option.Value" selected="@(Model.QuestionId.ToString() == option.Value)">@option.Text</option>
                }
            </select>
            <div class="form-text">Chỉ hiển thị câu hỏi đã duyệt (Approved).</div>
        </div>
    }

    <div class="mb-3">
        <label class="form-label fw-bold">Các tiêu chí chấm điểm</label>
        <div id="criteria-container">
            @for (int i = 0; i < Model.Criteria.Count; i++)
            {
                <partial name="_CriteriaRow" model="@(new { Index = i, Criteria = Model.Criteria[i] })" />
            }
        </div>
        <div class="d-flex gap-2 mt-2">
            <button type="submit" name="handler" value="AddCriterion" class="btn btn-outline-secondary btn-sm" formaction="?handler=AddCriterion">
                + Thêm tiêu chí
            </button>
            <div class="form-text">Tổng điểm = tổng điểm các tiêu chí.</div>
        </div>
    </div>

    <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary">@(isCreate ? "Tạo" : "Lưu")</button>
        <a class="btn btn-outline-secondary" asp-page="Index" asp-route-courseId="@ViewData["courseId"]" asp-route-term="@ViewData["term"]">Huỷ</a>
    </div>
</form>

@section Scripts {
    <script>
        // Handle remove criterion button
        document.addEventListener('click', function(e) {
            if (e.target.closest('.btn-remove-criterion')) {
                e.preventDefault();
                const btn = e.target.closest('.btn-remove-criterion');
                const form = document.createElement('form');
                form.method = 'post';
                form.innerHTML = `
                    <input type="hidden" name="courseId" value="@ViewData["courseId"]" />
                    <input type="hidden" name="term" value="@ViewData["term"]" />
                    <input type="hidden" name="RubricId" value="@Model.RubricId" />
                    <input type="hidden" name="QuestionId" value="@Model.QuestionId" />
                `;
                // Add current criteria as hidden inputs
                document.querySelectorAll('#criteria-container .criteria-row').forEach((row, idx) => {
                    const inputs = row.querySelectorAll('input, textarea, select');
                    inputs.forEach(input => {
                        const clone = input.cloneNode(true);
                        clone.name = input.name.replace(/\[\d+\]/, '[' + idx + ']');
                        form.appendChild(clone);
                    });
                });
                const indexInput = document.createElement('input');
                indexInput.type = 'hidden';
                indexInput.name = 'index';
                indexInput.value = btn.dataset.index;
                form.appendChild(indexInput);
                document.body.appendChild(form);
                form.submit();
            }
        });
    </script>
}