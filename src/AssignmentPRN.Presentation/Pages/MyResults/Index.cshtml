@page "{id:int}"
@model AssignmentPRN.Presentation.Pages.MyResults.IndexModel
@using AssignmentPRN.Presentation.ViewModels
@{
    ViewData["Title"] = "Bài làm & kết quả thi";
    var review = Model.Review;
    var isPublished = review.IsPublished;
}
<div class="exam-result-page"
     data-live-page="@(isPublished ? "ExamResults" : null)"
     data-exam-id="@review.ExamId"
     data-candidate-id="@review.CandidateId">
    <div class="page-header exam-result-header">
        <div>
            <a class="back-link" asp-page="/StudentSchedule/Mine">
                <partial name="/Pages/Shared/_Icon.cshtml" model="@("arrow-left")" /> Quay lại lịch thi
            </a>
            <h1>@(isPublished ? "Kết quả bài thi" : "Bài làm của bạn")</h1>
            @if (isPublished)
            {
                <p>Điểm dưới đây đã được giảng viên xem xét và công bố chính thức.</p>
            }
            else
            {
                <p>Điểm hiện đang được bảo mật. Điểm chính thức sẽ hiển thị sau khi giảng viên công bố.</p>
            }
        </div>
        @if (isPublished)
        {
            <div class="exam-result-score" aria-label="Điểm @ExamResultText.Score(review.FinalScore) trên 10">
                <span>Điểm công bố</span>
                <strong>@ExamResultText.Score(review.FinalScore)</strong>
                <small>/ 10</small>
            </div>
        }
        else
        {
            <span class="status-chip status-chip--warning">Chờ giảng viên công bố điểm</span>
        }
    </div>

    @if (!isPublished)
    {
        <div class="info-note">
            Bài thi của bạn đã được hệ thống ghi nhận. Điểm số và đánh giá chi tiết chưa được tiết lộ và sẽ chỉ hiển thị khi giảng viên công bố điểm. Hiện tại bạn chỉ có thể xem lại câu hỏi và câu trả lời của mình bên dưới.
        </div>
    }

    @if (isPublished && !string.IsNullOrWhiteSpace(review.LecturerComment))
    {
        <div class="content-card">
            <h2>Nhận xét của giảng viên</h2>
            <p>@review.LecturerComment</p>
        </div>
    }

    @if (isPublished && review.GradedQuestionCount > 0)
    {
        <div class="metric-row mb-3">
            <div class="metric-card"><span>Tổng điểm các câu</span><strong>@($"{review.QuestionTotalScore:0.##} / {review.GradedQuestionCount * 10}")</strong></div>
            <div class="metric-card"><span>Điểm trung bình mỗi câu</span><strong>@($"{review.QuestionAverageScore:0.##} / 10")</strong></div>
            <div class="metric-card"><span>Số câu đã chấm</span><strong>@($"{review.GradedQuestionCount} / {review.Answers.Count}")</strong></div>
        </div>
    }

    <div class="content-card exam-result-ai">
        <div class="section-heading">
            <div>
                <h2>@(isPublished ? "Chi tiết từng câu hỏi" : "Câu trả lời của bạn")</h2>
                <p class="text-muted">
                    @(isPublished
                        ? "Chi tiết câu hỏi, phần trả lời của bạn và nhận xét sau khi công bố điểm."
                        : "Nội dung bạn đã trả lời trong phiên thi vấn đáp.")
                </p>
            </div>
        </div>
        @if (review.Answers.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon"><partial name="/Pages/Shared/_Icon.cshtml" model="@("question")" /></div>
                <h2>Chưa có nội dung</h2>
                <p>Bài thi này chưa ghi nhận câu trả lời nào.</p>
            </div>
        }
        else
        {
            <ol class="exam-result-ai-answers">
                @foreach (var answer in review.Answers)
                {
                    <li>
                        @if (isPublished && answer.AiScore.HasValue)
                        {
                            <h3>Câu @answer.OrderNo · @ExamResultText.Score(answer.AiScore)</h3>
                        }
                        else
                        {
                            <h3>Câu @answer.OrderNo</h3>
                        }
                        <p class="fw-medium mb-2">@answer.QuestionText</p>
                        <div class="exam-result-expected mb-2">
                            <span>Bạn đã trả lời</span>
                            <p>@(string.IsNullOrWhiteSpace(answer.Transcript) ? "Không có nội dung nhận dạng." : answer.Transcript)</p>
                        </div>

                        @if (isPublished && !answer.NotGraded)
                        {
                            @if (answer.Criteria.Count > 0)
                            {
                                <table class="data-table">
                                    <thead><tr><th>Tiêu chí</th><th>Điểm</th><th>Nhận xét</th></tr></thead>
                                    <tbody>
                                    @foreach (var criterion in answer.Criteria)
                                    {
                                        <tr>
                                            <td>@criterion.Name</td>
                                            <td class="cell-nowrap">@criterion.Awarded.ToString("0.##") / @criterion.MaxScore.ToString("0.##")</td>
                                            <td>@(criterion.Comment ?? "—")</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            }
                            @if (!string.IsNullOrWhiteSpace(answer.Strengths))
                            {
                                <p><strong>Điểm mạnh:</strong> @answer.Strengths</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(answer.Weaknesses))
                            {
                                <p><strong>Điểm yếu:</strong> @answer.Weaknesses</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(answer.MissingPoints))
                            {
                                <p><strong>Ý còn thiếu:</strong> @answer.MissingPoints</p>
                            }
                        }

                        @if (answer.Probes.Count > 0)
                        {
                            <div class="exam-result-probes">
                                <div class="exam-result-probes__header">
                                    <span class="exam-result-probes__badge">Câu hỏi bổ sung · @answer.Probes.Count</span>
                                </div>
                                <ol class="exam-result-probes__list">
                                    @for (var pIdx = 0; pIdx < answer.Probes.Count; pIdx++)
                                    {
                                        var probe = answer.Probes[pIdx];
                                        var noProbeReply = string.IsNullOrWhiteSpace(probe.Transcript);
                                        <li class="exam-result-probes__item">
                                            <p class="exam-result-probes__question">Câu bổ sung @(pIdx + 1): @probe.Question</p>
                                            <p class="exam-result-probes__answer @(noProbeReply ? "exam-result-probes__answer--empty" : null)">
                                                <strong>Bạn đã trả lời:</strong>
                                                @(noProbeReply ? "Bạn không trả lời câu này." : probe.Transcript)
                                            </p>
                                        </li>
                                    }
                                </ol>
                            </div>
                        }
                    </li>
                }
            </ol>
        }
    </div>
</div>

@if (isPublished)
{
    @section Scripts {
        <script src="~/js/grading-live.js" asp-append-version="true"></script>
    }
}
