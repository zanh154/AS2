@page "{id:int?}"
@model AssignmentPRN.Presentation.Pages.ExamResults.CandidateModel
@using AssignmentPRN.Presentation.ViewModels
@{
    // Đặt ở trang, không ở partial: <partial> nhận một bản sao ViewData, nên tiêu đề và
    // breadcrumb mà partial ghi vào không bao giờ tới được layout.
    if (Model.Data is CandidateResultViewModel { Candidate: var candidate })
    {
        ViewData["Title"] = $"Bài làm · {candidate.StudentName}";
        ViewData["Breadcrumb"] = new List<BreadcrumbItem>
        {
            new("Lịch thi", "ExamSessions", "Index"),
            new(candidate.Paper.ExamName, "ExamSessions", "Details", new { id = candidate.ExamId }),
            new("Kết quả", "ExamResults", "Index", new { id = candidate.ExamId }),
            new(candidate.StudentName)
        };
    }
}
<partial name="/Pages/Shared/ExamResultsCandidate.cshtml" model="Model.Data" />
