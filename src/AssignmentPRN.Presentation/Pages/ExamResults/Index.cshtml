@page "{id:int?}"
@model AssignmentPRN.Presentation.Pages.ExamResults.IndexModel
@using AssignmentPRN.Presentation.ViewModels
@{
    // Đặt ở trang, không ở partial: <partial> nhận một bản sao ViewData, nên tiêu đề và
    // breadcrumb mà partial ghi vào không bao giờ tới được layout.
    if (Model.Data is SessionResultViewModel { Session: var session })
    {
        ViewData["Title"] = $"Kết quả · {session.ExamName}";
        ViewData["Breadcrumb"] = new List<BreadcrumbItem>
        {
            new("Lịch thi", "ExamSessions", "Index"),
            new(session.ExamName, "ExamSessions", "Details", new { id = session.ExamId }),
            new("Kết quả")
        };
    }
}
<partial name="/Pages/Shared/ExamResultsIndex.cshtml" model="Model.Data" />
