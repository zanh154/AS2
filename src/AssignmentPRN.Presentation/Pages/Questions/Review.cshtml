@page
@model AssignmentPRN.Presentation.Pages.Questions.ReviewModel
@{
    ViewData["Title"] = "Duyệt câu hỏi AI";
}
<div class="page-header">
    <div>
        <span class="eyebrow">Module 5</span>
        <h1>Duyệt câu hỏi AI</h1>
        <p>Câu hỏi do AI sinh được giữ riêng ở đây. Chỉ câu được duyệt mới vào ngân hàng và được phát đề.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="/Questions/Index" asp-route-courseId="@Model.CourseId">Ngân hàng câu hỏi</a>
    </div>
</div>

<form method="get" class="content-card question-filters">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label" for="courseId">Môn học</label>
            <select id="courseId" name="courseId" class="form-select">
                <option value="">Tất cả môn đã phân công</option>
                @foreach (var option in Model.CourseOptions)
                {
                    <option value="@option.Value" selected="@(Model.CourseId?.ToString() == option.Value)">@option.Text</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button class="btn btn-primary" type="submit">Lọc</button>
            <a class="btn btn-outline-secondary" asp-page="Review">Xoá lọc</a>
        </div>
    </div>
</form>

@if (Model.LoadError is not null)
{
    <div class="alert alert-danger app-alert" role="alert">@Model.LoadError</div>
}

<div class="content-card">
    <div class="section-heading">
        <div>
            <h2>Câu chờ duyệt</h2>
            <p class="text-muted">Có @Model.Questions.Count câu hỏi AI đang chờ duyệt.</p>
        </div>
    </div>

    @if (Model.Questions.Count == 0)
    {
        <div class="empty-state">
            <h2>Không có câu hỏi nào chờ duyệt</h2>
            <p>Câu hỏi do AI sinh sẽ xuất hiện ở đây để bạn duyệt hoặc từ chối.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Nội dung</th>
                        <th>Môn / Chủ đề</th>
                        <th>Độ khó</th>
                        <th>Bloom</th>
                        <th>Nguồn</th>
                        <th>Ngày tạo</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var question in Model.Questions)
                    {
                        <tr>
                            <td>
                                <p class="question-cell">@question.QuestionText</p>
                                @if (question.QuestionType == QuestionType.FollowUp)
                                {
                                    <span class="status-chip">@QuestionText.Type(question.QuestionType)</span>
                                }
                            </td>
                            <td>
                                <strong>@question.CourseCode</strong>
                                <div class="text-muted">@(question.MaterialName ?? "Chưa gán chủ đề")</div>
                            </td>
                            <td><span class="status-chip @QuestionText.DifficultyChip(question.Difficulty)">@QuestionText.Difficulty(question.Difficulty)</span></td>
                            <td>@QuestionText.Bloom(question.BloomLevel)</td>
                            <td><span class="status-chip">@QuestionText.Source(question.Source)</span></td>
                            <td>
                                @question.AuthorName
                                <div class="text-muted">@question.CreatedAt.ToString("dd/MM/yyyy")</div>
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a class="btn btn-outline-secondary btn-sm" asp-page="/Questions/Edit" asp-route-id="@question.QuestionId">Sửa</a>
                                    <form asp-page-handler="Approve" asp-route-id="@question.QuestionId" method="post" data-confirm="Duyệt câu hỏi này? Câu đã duyệt sẽ được phát đề.">
                                        <button class="btn btn-success btn-sm">Duyệt</button>
                                    </form>
                                    <form asp-page-handler="Reject" asp-route-id="@question.QuestionId" method="post" data-confirm="Từ chối câu hỏi này? Câu bị từ chối sẽ không được phát đề.">
                                        <button class="btn btn-outline-danger btn-sm">Từ chối</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
