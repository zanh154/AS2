%% AIVES - kiến trúc 3 tầng. Dán vào draw.io: Arrange > Insert > Advanced > Mermaid.
flowchart TB
    Browser["Lecturer · Student · Admin<br/>Web Browser<br/>SignalR Client"]

    subgraph P["1. PRESENTATION LAYER — AssignmentPRN.Presentation"]
        direction TB
        subgraph P1[" "]
            direction LR
            Pages["Pages/<br/>Razor Pages"] ~~~ Security["Security/<br/>Role rules · Session actor"] ~~~ Constants["Constants/<br/>SessionKeys · RoleNames"] ~~~ Filters["Filters/<br/>Authorize Filters"]
        end
        subgraph P2[" "]
            direction LR
            ViewModels["ViewModels/<br/>Form / View models"] ~~~ Hub["Hub/<br/>SignalR endpoint"] ~~~ Realtime["Realtime/<br/>SignalR adapter"] ~~~ UI["UI Assets"]
        end
        P1 ~~~ P2
    end

    subgraph B["2. BUSINESS LOGIC LAYER — AssignmentPRN.Business"]
        direction LR
        Services["Services"] ~~~ Interfaces["Interfaces"]
    end

    subgraph T["THIRD-PARTY"]
        Ollama["Ollama Local"]
    end

    subgraph D["3. DATA ACCESS LAYER — AssignmentPRN.DataAccess"]
        direction LR
        Repo["Repositories"] ~~~ Ctx["AivesDbContext"] ~~~ Files["File Store"]
    end

    DB[("DATABASE · MySQL 8.4")]
    Disk[("LOCAL DISK STORAGE")]

    Browser -->|Request| P
    Browser <-.-|Response| P
    P -->|Request| B
    P <-.-|Response| B
    B -->|Request| T
    B <-.-|Response| T
    B -->|Request| D
    B <-.-|Response| D
    D -->|Request| DB
    D <-.-|Response| DB
    D -->|Request| Disk
    D <-.-|Response| Disk

    classDef card fill:#ffffff,stroke:#b7c8e6,color:#1f2d3d
    classDef client fill:#e8eefb,stroke:#9db4dc,color:#1f2d3d
    classDef store fill:#e6f0f7,stroke:#9fbcd4,color:#1f2d3d
    class Pages,Security,Constants,Filters,ViewModels,Hub,Realtime,UI card
    class Services,Interfaces,Repo,Ctx,Files,Ollama card
    class Browser client
    class DB,Disk store
    style P fill:#e8eefb,stroke:#9db4dc
    style B fill:#e9f6ef,stroke:#9fd2b4
    style D fill:#f1ebf8,stroke:#c7b4e0
    style T fill:#fcf3e6,stroke:#e8c48f
    style P1 fill:none,stroke:none
    style P2 fill:none,stroke:none
