flowchart TB
    subgraph Users["Users"]
        direction LR
        Admin["Admin"]
        Lecturer["Lecturer"]
        Student["Student"]
        Browser["Web browser<br/>HTML · CSS · JavaScript"]
        Admin --> Browser
        Lecturer --> Browser
        Student --> Browser
    end

    subgraph Presentation["Presentation — ASP.NET Core MVC (.NET 10)"]
        direction TB
        Pipeline["HTTP pipeline<br/>Static Files · Routing · Session · Authorization"]
        Controllers["Controllers<br/>14 MVC controllers"]
        ViewModels["ViewModels<br/>Binding · Validation"]
        Views["Razor Views<br/>.cshtml"]
        PresentationOut[" "]
        Pipeline --> Controllers --> ViewModels --> Views
        Controllers --> PresentationOut
        Views --> PresentationOut
    end

    subgraph Business["Business — Services"]
        direction TB
        ServicePorts["Service interfaces<br/>IAuthService · IExamSessionService · ..."]
        Services["Services<br/>Auth · Course · Class · Exam · Question · Result<br/>Scheduling · Picking · Scoring · Follow-up"]
        Policies["Policies<br/>ExamSessionRules · ExamLifecycleRules · ExamStatePolicy"]
        Contracts["Public contracts<br/>Request · Response · Enums"]
        BusinessOut[" "]
        ServicePorts --> Services
        ServicePorts --- Contracts
        Services -.-> Policies
        Services --> BusinessOut
    end

    subgraph DataAccess["DataAccess — Persistence and infrastructure"]
        direction TB
        Repositories["8 repositories<br/>Queries · Commands · Transactions"]
        DataModels["Internal data models<br/>Entities · Read models · Enums"]
        EF["EF Core 9<br/>Pomelo MySQL provider"]
        DbContext["AivesDbContext<br/>12 entity models"]
        DbCheck["Startup DB check<br/>CanConnect + data counts"]
        FileStore["LocalMaterialFileStore"]
        MaterialFiles[("Material files<br/>Storage/materials")]
        Repositories --> DataModels --> EF --> DbContext
        DbCheck -.-> DbContext
    end

    subgraph Configuration["Database configuration at startup"]
        direction LR
        Settings["appsettings / environment<br/>DefaultConnection"]
        Program["Program.cs<br/>GetConnectionString"]
        Registration["AddBusiness → AddDataAccess<br/>UseMySql(connectionString)"]
        Settings --> Program --> Registration
    end

    subgraph Resources["External resource"]
        direction LR
        MySQL[("MySQL 8.4<br/>Aiven · TLS")]
    end

    Browser -->|"HTTP request<br/>HTML response"| Pipeline
    PresentationOut -->|"calls service interface"| ServicePorts
    BusinessOut -->|"repository call"| Repositories
    Policies -.->|"IExamStatePolicy<br/>evaluated inside transaction"| Repositories
    Services -->|"save · open · delete file"| FileStore
    Registration -.->|"configures DbContextOptions"| EF
    Registration -.->|"registers implementation"| FileStore
    DbContext -->|"SQL command<br/>result rows"| MySQL
    FileStore -->|"file I/O"| MaterialFiles

    classDef actor fill:#fff4cc,stroke:#c79200,color:#3d3100
    classDef client fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e
    classDef presentation fill:#dbeafe,stroke:#2563eb,color:#172554
    classDef business fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef data fill:#f3e8ff,stroke:#9333ea,color:#581c87
    classDef config fill:#e2e8f0,stroke:#64748b,color:#1e293b
    classDef storage fill:#fee2e2,stroke:#dc2626,color:#7f1d1d
    classDef hidden fill:transparent,stroke:transparent,color:transparent

    class Admin,Lecturer,Student actor
    class Browser client
    class Pipeline,Controllers,ViewModels,Views presentation
    class ServicePorts,Services,Policies,Contracts business
    class Repositories,DataModels,EF,DbContext,DbCheck,FileStore data
    class Settings,Program,Registration config
    class MySQL,MaterialFiles storage
    class PresentationOut,BusinessOut hidden

    style Users fill:#fffbeb,stroke:#d6a700,stroke-width:2px
    style Presentation fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style Business fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    style DataAccess fill:#faf5ff,stroke:#9333ea,stroke-width:2px
    style Configuration fill:#f8fafc,stroke:#64748b,stroke-width:2px
    style Resources fill:#fff1f2,stroke:#dc2626,stroke-width:2px
