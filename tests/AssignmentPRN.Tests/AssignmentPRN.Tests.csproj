    <Compile Remove="bin-alt/**/*.cs;ExamSchedulePlannerTests.cs;ExamSessionRepositoryTests.cs;ModuleTwoRegressionTests.cs;ModuleTwoTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AssignmentPRN.Business\AssignmentPRN.Business.csproj" />
    <ProjectReference Include="..\..\src\AssignmentPRN.Presentation\AssignmentPRN.Presentation.csproj" />
  </ItemGroup>

</Project>
